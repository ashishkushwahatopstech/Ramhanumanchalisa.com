datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// NextAuth.js User, Account, Session Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Blog Posts
model Post {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  metaTitle      String?
  metaDescription String?
  content        String
  excerpt        String
  coverImage     String?
  imageAlt       String?
  imageTitle     String?
  imageCaption   String?
  focusKeywords  String?
  internalLinks  String?  // JSON string: Array<{ label: string, url: string }>
  sources        String?  // JSON string or text citations
  faqs           String?  // JSON string: Array<{ question: string, answer: string }>
  galleryImages  String?  // JSON string: Array<{ id: string, url: string, alt: string, title: string, caption: string }>
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Benefits Pages
model Benefit {
  id                     String   @id @default(cuid())
  slug                   String   @unique
  title                  String
  metaTitle              String?
  metaDescription        String?
  situation              String
  icon                   String?  @default("🙏")
  description            String
  recommendedChants      String?
  targetVerseNumber      Int?
  targetVerseText        String?
  targetVerseTranslation String?
  detailedExposition     String
  actionSteps            String?  // JSON string: string[]
  coverImage             String?
  imageAlt               String?
  imageTitle             String?
  imageCaption           String?
  galleryImages          String?  // JSON string: Array<{ id: string, url: string, alt: string, title: string, caption: string }>
  focusKeywords          String?
  internalLinks          String?  // JSON string: Array<{ label: string, url: string }>
  sources                String?  // JSON string or text citations
  faqs                   String?  // JSON string: Array<{ question: string, answer: string }>
  published              Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// Page FAQs (auto-schema generator)
model Faq {
  id        String   @id @default(cuid())
  pageSlug  String   // e.g. "path-vidhi", "benefits"
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Audio recitations & timestamps metadata for line-syncing
model AudioTrack {
  id             String   @id @default(cuid())
  reciterName    String
  url            String
  duration       Int      // Duration in seconds
  description    String?
  isDefault      Boolean  @default(false)
  timestampsJSON String?  // JSON string storing line-sync timestamps
  createdAt      DateTime @default(now())
}

// Evergreen Festival Config
model JayantiConfig {
  id          String   @id @default(cuid())
  year        Int      @unique
  date        String   // YYYY-MM-DD
  pujaMuhurat String   // e.g., "06:11 AM to 08:30 AM"
  description String?
  updatedAt   DateTime @updatedAt
}

// Daily ambient counter
model RecitationCounter {
  id    String @id @default(cuid())
  date  String @unique // YYYY-MM-DD
  count Int    @default(0)
}

// Language Content Database for D1/Edge dynamic edits
model LanguageContent {
  id              String   @id @default(cuid())
  lang            String   @unique // "hi", "en", "te", "bn", "kn"
  title           String
  metaDescription String
  contentJSON     String   // Stores verses, meanings, and FAQs in JSON format
  published       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

// Uploaded Media Images for Edge & SEO
model MediaImage {
  id         String   @id @default(cuid())
  path       String   @unique
  fileName   String
  folder     String
  mimeType   String
  dataBase64 String
  size       Int
  createdAt  DateTime @default(now())
}

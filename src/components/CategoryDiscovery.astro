---
const CATEGORIES = [
  {
    name: "Hanuman Ji",
    hindiName: "श्री हनुमान जी",
    icon: "🚩",
    desc: "Chalisa, Sankat Mochan Ashtak, Aarti, Stuti, 40 Benefits & Chanting Rules.",
    href: "/blog?category=Hanuman%20Ji",
    badge: "मुख्य संग्रह",
  },
  {
    name: "Shri Ram",
    hindiName: "मर्यादा पुरुषोत्तम श्री राम",
    icon: "🏹",
    desc: "Shri Ram Chalisa, Ramayan Aarti, Ramchandra Kripalu, and Ram Rajya treatises.",
    href: "/blog?category=Shri%20Ram",
    badge: "रघुवंश",
  },
  {
    name: "Lord Shiva",
    hindiName: "देवाधिदेव महादेव",
    icon: "🔱",
    desc: "Shri Shiv Chalisa, Mahakal Chalisa, Ardhnarishwar Stotram & Rudra Aartis.",
    href: "/blog?category=Lord%20Shiva",
    badge: "कैलाश",
  },
  {
    name: "Maa Durga & Devis",
    hindiName: "माँ दुर्गा एवं देवी शक्ति",
    icon: "🪔",
    desc: "Durga Chalisa, Lakshmi Chalisa, Saraswati Chalisa, Ambe Aarti & Navratri hymns.",
    href: "/blog?category=Maa%20Durga%20%26%20Devis",
    badge: "शक्ति पीठ",
  },
  {
    name: "Lord Ganesh",
    hindiName: "विघ्नहर्ता श्री गणेश",
    icon: "🐘",
    desc: "Ganesh Chalisa, Ganpati Stotra, Marathi Aartis, and Vinayaka Chaturthi stotras.",
    href: "/blog?category=Lord%20Ganesh",
    badge: "प्रथम पूज्य",
  },
  {
    name: "Lord Krishna",
    hindiName: "भगवान श्री कृष्ण",
    icon: "🦚",
    desc: "Krishna Chalisa, Krishna Aarti, Radha Chalisa, and Khatu Shyam hymns.",
    href: "/blog?category=Lord%20Krishna",
    badge: "लीला पुरुषोत्तम",
  },
  {
    name: "Devtas & Saints",
    hindiName: "देवता एवं पूज्य संत",
    icon: "🛕",
    desc: "Surya Dev Aarti, Shani Chalisa, Sai Baba Chalisa, and Navgraha Stotras.",
    href: "/blog?category=Devtas%20%26%20Saints",
    badge: "ग्रह व संत",
  },
  {
    name: "Devotional Prayers",
    hindiName: "पवित्र स्तोत्र व प्रार्थना",
    icon: "📜",
    desc: "Vishnu Sahasranamam, Sunderkand, Hanuman Bahuk, and Vedic stotras.",
    href: "/blog?category=Devotional%20Prayers",
    badge: "स्तोत्र निधि",
  },
];
---

<section class="max-w-6xl mx-auto px-4 py-8" aria-label="Explore Devotional Categories">
  <div class="text-center mb-8 space-y-2">
    <div class="flex justify-center">
      <span class="rubric-marker">
        <span>— वर्ग प्रभाग : संपूर्ण देव उपासना संग्रह —</span>
      </span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-serif-display font-bold text-[#4A1216]">
      Explore Sacred Categories & Deity Collections
    </h2>
    <p class="text-xs sm:text-sm text-[#34251D]/75 max-w-xl mx-auto font-sans leading-relaxed">
      Browse our extensive archive of authentic Awadhi, Sanskrit, Hindi, and Marathi devotional prayers organized by revered deity and spiritual tradition.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    {CATEGORIES.map((cat) => (
      <a
        href={cat.href}
        class="devotional-card p-5 flex flex-col justify-between group hover:border-[#E87524]"
      >
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-3xl group-hover:scale-110 transition-transform">
              {cat.icon}
            </span>
            <span class="text-[10px] font-bold text-[#C95716] bg-[#E87524]/10 border border-[#C9A45C]/35 px-2 py-0.5 rounded-full uppercase">
              {cat.badge}
            </span>
          </div>

          <div>
            <h3 class="font-serif-display font-bold text-base text-[#4A1216] group-hover:text-[#E87524] transition-colors leading-snug">
              {cat.name}
            </h3>
            <span class="font-hindi-display text-xs text-[#C95716] font-semibold block mt-0.5">
              {cat.hindiName}
            </span>
          </div>

          <p class="text-xs text-[#34251D]/75 line-clamp-2 leading-relaxed font-sans">
            {cat.desc}
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-[#C9A45C]/20 flex items-center justify-between text-xs font-bold text-[#C95716]">
          <span>Explore Collection</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </a>
    ))}
  </div>
</section>

---
import { getPrisma } from "../lib/prisma";

interface FaqPair {
  question: string;
  answer: string;
}

interface Props {
  pageSlug: string;
  altSlugs?: string[];
  fallbackFaqs?: FaqPair[];
  title?: string;
  subTitle?: string;
}

const {
  pageSlug,
  altSlugs = [],
  fallbackFaqs = [],
  title = "Frequently Asked Questions",
  subTitle = "Clear, authentic answers according to sacred traditions and scriptures.",
} = Astro.props;

const db = Astro.locals.runtime?.env?.DB;
const prisma = getPrisma(db);

const lookupSlugs = [pageSlug, ...altSlugs].filter(Boolean);

let faqs: FaqPair[] = [...fallbackFaqs];

try {
  const dbFaqs = await prisma.faq.findMany({
    where: { pageSlug: { in: lookupSlugs } },
    orderBy: { order: "asc" },
  });

  if (dbFaqs.length > 0) {
    const mappedDbFaqs = dbFaqs.map((f) => ({
      question: f.question,
      answer: f.answer,
    }));

    // If DB FAQs exist, they take precedence
    faqs = mappedDbFaqs;
  }
} catch (error) {
  console.warn(`PageFaqs: Could not fetch FAQs for ${pageSlug}, using fallbacks:`, error);
}

// Google Search Console compliant FAQPage Schema
const faqSchema =
  faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqs.map((item) => ({
          "@type": "Question",
          "name": item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer.replace(/<[^>]*>/g, ""),
          },
        })),
      }
    : null;
---

{faqs.length > 0 && (
  <section class="my-10 bg-stone-ivory border-2 border-brass-gold/40 rounded-xl p-6 sm:p-8 shadow-sm space-y-6">
    <!-- Google Search Console FAQPage Schema -->
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}

    <div class="border-b border-brass-gold/20 pb-4 text-center sm:text-left">
      <div class="flex items-center justify-center sm:justify-start gap-2">
        <span class="text-2xl">❓</span>
        <h2 class="font-serif-display text-xl sm:text-2xl font-bold text-maroon-deep uppercase">
          {title}
        </h2>
      </div>
      {subTitle && (
        <p class="text-xs text-charcoal-brown/70 mt-1">
          {subTitle}
        </p>
      )}
    </div>

    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <details class="group bg-white rounded-lg border border-brass-gold/30 p-4 transition-all open:shadow-sm">
          <summary class="font-bold text-sm text-maroon-deep cursor-pointer list-none flex justify-between items-center select-none">
            <span class="pr-4">{faq.question}</span>
            <span class="text-brass-gold transition-transform group-open:rotate-180 flex-shrink-0">
              ▼
            </span>
          </summary>
          <div class="mt-3 pt-3 border-t border-brass-gold/20 text-xs sm:text-sm text-charcoal-brown/85 leading-relaxed">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </section>
)}

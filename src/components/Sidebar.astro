---
import { FALLBACK_BLOG_POSTS, type BlogPost } from "../data/blog";
import { d1GetBlogConfig, d1GetPosts, d1GetSiteConfig } from "../lib/d1";
import { getBlogConfig, type BlogLayoutConfig } from "../lib/dynamicContent";
import { getSiteLayoutConfig, type SiteLayoutConfig } from "../lib/siteConfig";
import GadgetRenderer from "./gadgets/GadgetRenderer.astro";
import AdSlot from "./AdSlot.astro";

const db = Astro.locals.runtime?.env?.DB;

// Load Site Layout & Gadgets Configuration
let siteConfig: SiteLayoutConfig | null = null;
if (db && typeof db.prepare === "function") {
  try {
    siteConfig = await d1GetSiteConfig(db);
  } catch (e) {
    console.warn("Notice: D1 getSiteConfig in Sidebar.astro:", e);
  }
}
if (!siteConfig) {
  siteConfig = getSiteLayoutConfig();
}

// Load Blog Layout Configuration
let blogConfig: BlogLayoutConfig | null = null;
if (db && typeof db.prepare === "function") {
  try {
    blogConfig = await d1GetBlogConfig(db);
  } catch (e) {
    console.warn("Notice: D1 getBlogConfig in Sidebar.astro:", e);
  }
}
if (!blogConfig) {
  blogConfig = getBlogConfig();
}

// Load Recent Posts for Gadgets
let recentPosts: BlogPost[] = [];
try {
  let posts: any[] = [];
  if (db && typeof db.prepare === "function") {
    posts = await d1GetPosts(db);
  }
  if (posts.length === 0) {
    posts = FALLBACK_BLOG_POSTS;
  }
  posts.sort((a: any, b: any) => {
    const timeA = new Date(a.createdAt).getTime() || 0;
    const timeB = new Date(b.createdAt).getTime() || 0;
    return timeB - timeA;
  });
  recentPosts = posts.slice(0, 10);
} catch (e) {
  recentPosts = FALLBACK_BLOG_POSTS.slice(0, 10);
}

const isSidebarEnabled = siteConfig?.sidebarEnabled ?? (blogConfig?.sidebarEnabled ?? true);
const activeGadgets = (siteConfig?.sidebarGadgets || []).filter((g) => g.isEnabled);
---

{isSidebarEnabled && (
  <div class="no-print space-y-6">
    {/* Optional Sidebar Ad Slot */}
    {siteConfig?.adSlots?.sidebar?.enabled && (
      <AdSlot slotConfig={siteConfig.adSlots.sidebar} slotId="sidebar" />
    )}

    {/* Dynamic Predefined Gadgets */}
    {activeGadgets.length > 0 ? (
      activeGadgets.map((gadget) => (
        <GadgetRenderer gadget={gadget} recentPosts={recentPosts} />
      ))
    ) : (
      /* Fallback if no gadgets configured */
      <>
        {blogConfig?.aboutTitle && (
          <div class="bg-stone-ivory border border-brass-gold/35 rounded-xl p-5 shadow-xs space-y-2.5">
            <div class="flex items-center gap-2 border-b border-brass-gold/20 pb-2">
              <span class="text-xl">🛕</span>
              <h3 class="font-serif-display font-bold text-maroon-deep text-base uppercase tracking-wider">
                {blogConfig.aboutTitle}
              </h3>
            </div>
            <p class="text-xs text-charcoal-brown/80 leading-relaxed">
              {blogConfig.aboutContent}
            </p>
          </div>
        )}
      </>
    )}
  </div>
)}

<section class="max-w-6xl mx-auto px-4 py-8" aria-label="Popular Devotional Collections">
  <div class="text-center mb-8 space-y-2">
    <div class="flex justify-center">
      <span class="rubric-marker">
        <span>— संग्रह प्रभाग : मुख्य उपासना ग्रंथ —</span>
      </span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-serif-display font-bold text-[#4A1216]">
      Popular Devotional Collections
    </h2>
    <p class="text-xs sm:text-sm text-[#34251D]/75 max-w-xl mx-auto font-sans leading-relaxed">
      Curated sacred prayers and audio companions revered by millions of devotees for daily home mandir recitation.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {COLLECTIONS.map((item) => (
      <a
        href={item.href}
        class="devotional-card p-6 flex flex-col justify-between group hover:border-[#E87524]"
      >
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-3xl group-hover:scale-110 transition-transform">
              {item.icon}
            </span>
            <span class="text-[10px] font-bold text-[#C95716] bg-[#E87524]/10 border border-[#C9A45C]/35 px-2.5 py-0.5 rounded-full uppercase">

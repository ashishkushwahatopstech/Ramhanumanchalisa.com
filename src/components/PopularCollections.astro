          </div>

          <div>
            <h3 class="font-serif-display font-bold text-lg text-[#4A1216] group-hover:text-[#E87524] transition-colors leading-snug">
              {item.title}
            </h3>
            <span class="font-hindi-display text-xs text-[#C95716] font-semibold block mt-1">
              {item.hindiTitle}
            </span>
          </div>

          <p class="text-xs sm:text-sm text-[#34251D]/75 leading-relaxed font-sans">
            {item.desc}
          </p>
        </div>

        <div class="mt-5 pt-3 border-t border-[#C9A45C]/20 flex items-center justify-between text-xs font-bold text-[#C95716]">
          <span>Read & Recite</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </div>
      </a>
    ))}

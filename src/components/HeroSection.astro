---
interface Props {
  dailyQuote?: {
    verse: string;
    meaning: string;
  };
}

const {
  dailyQuote = {
    verse: "दुर्गम काज जगत के जेते। सुगम अनुग्रह तुम्हरे तेते॥",
    meaning: "All formidable tasks in this world become effortless by your divine grace.",
  },
} = Astro.props;
---

<section class="relative overflow-hidden pt-4 pb-8 sm:py-12 bg-gradient-to-b from-[#FFF9F0] via-[#FAF3E8] to-[#FFF9F0] border-b border-[#C9A45C]/25" aria-label="Devotional Hero Entrance">
  <!-- Subtle Ambient Glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl h-80 bg-gradient-to-b from-[#E87524]/10 via-[#C9A45C]/5 to-transparent blur-3xl pointer-events-none" />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center space-y-5 max-w-3xl mx-auto">
      
      <!-- Rubric Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E87524]/10 border border-[#C9A45C]/40 text-[#C95716] text-xs font-bold uppercase tracking-wider">
        <span class="animate-pulse">🪔</span>
        <span>श्री राम जय राम जय जय राम • नित्य साधना पीठ</span>
      </div>

      <!-- Main Headline -->
      <h1 class="font-serif-display text-3xl sm:text-5xl lg:text-6xl font-bold text-[#4A1216] tracking-tight leading-[1.15]">
        Shree Hanuman Chalisa
        <span class="font-hindi-display block text-2xl sm:text-4xl text-[#C95716] font-semibold mt-2">
          सम्पूर्ण चालीसा पाठ एवं शब्दार्थ
        </span>
      </h1>

      <!-- Description -->
      <p class="text-sm sm:text-base text-[#34251D]/85 leading-relaxed font-sans max-w-2xl mx-auto">
        Recite the timeless 40 Awadhi chaupais composed by Goswami Tulsidas with authentic word breakdowns, synchronized audio recitations, downloadable PDF sheets, and step-by-step path vidhi.
      </p>

      <!-- Key Attribute Badges -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs font-semibold text-[#4A1216] pt-1">
        <span class="px-3 py-1 rounded-full bg-white border border-[#C9A45C]/35 shadow-2xs">४० सिद्ध चौपाई</span>
        <span class="px-3 py-1 rounded-full bg-white border border-[#C9A45C]/35 shadow-2xs">७ प्रादेशिक भाषाएं</span>
        <span class="px-3 py-1 rounded-full bg-white border border-[#C9A45C]/35 shadow-2xs">सस्वर ऑडियो प्लेयर</span>
        <span class="px-3 py-1 rounded-full bg-white border border-[#C9A45C]/35 shadow-2xs">शास्त्रोक्त विधि</span>
      </div>

      <!-- Primary Action Buttons -->
      <div class="pt-3 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
        <a
          href="#chalisa-recitation"
          class="w-full sm:w-auto px-7 py-3 rounded-full bg-[#C95716] hover:bg-[#E87524] text-white font-bold text-sm tracking-wide uppercase shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2 border border-[#C9A45C]"
        >
          <span>🕉️</span>
          <span>Read Hanuman Chalisa</span>
          <span>↓</span>
        </a>
        <a
          href="/stories"
          class="w-full sm:w-auto px-6 py-3 rounded-full bg-white hover:bg-[#FAF3E8] text-[#4A1216] font-bold text-sm tracking-wide uppercase border border-[#C9A45C]/50 hover:border-[#E87524] shadow-xs transition-all flex items-center justify-center gap-2"
        >
          <span>✨</span>
          <span>Explore Devotional Stories</span>
          <span>→</span>
        </a>
      </div>

      <!-- Sacred Daily Assurance Card -->
      <div class="mt-8 p-4 sm:p-5 rounded-2xl bg-white/80 border border-[#C9A45C]/35 shadow-xs max-w-xl mx-auto backdrop-blur-xs">
        <div class="text-[11px] font-bold uppercase tracking-wider text-[#C95716] mb-1">
          — अमृत वचन • Sacred Verse of Protection —
        </div>
        <p class="font-hindi-display text-base sm:text-lg text-[#4A1216] font-bold">
          {dailyQuote.verse}
        </p>
        <p class="text-xs text-[#34251D]/75 mt-1 font-sans italic">
          "{dailyQuote.meaning}"
        </p>
      </div>

    </div>
  </div>
</section>

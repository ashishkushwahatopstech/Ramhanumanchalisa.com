---
import type { BlockInstance } from "../../../lib/pagebuilder/schema";

interface Props {
  block: BlockInstance;
}

const { block } = Astro.props;
const content = block.content || {};
const slotId = content.slotId || "inContent";
const label = content.label || "Advertisement";
---

<!-- Block: AdSlot [LOCKED RULES: Stable CLS min-height, verified client ID] -->
<div id={block.id} class="ad-slot-block no-print w-full my-6 text-center max-w-4xl mx-auto" data-slot={slotId}>
  {label && (
    <div class="text-[10px] uppercase tracking-widest text-[#34251D]/50 mb-1 font-mono">
      {label}
    </div>
  )}

  {content.code ? (
    <div
      class="w-full flex justify-center items-center overflow-hidden min-h-[90px] sm:min-h-[120px]"
      set:html={content.code}
    />
  ) : (
    <div
      class="w-full h-24 bg-transparent overflow-hidden my-2 border border-dashed border-[#C9A45C]/20 rounded-md flex items-center justify-center text-[11px] text-[#34251D]/40 font-mono"
      aria-hidden="true"
    >
      Ad Slot: {slotId}
    </div>
  )}
</div>

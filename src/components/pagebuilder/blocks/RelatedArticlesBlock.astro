---
import type { BlockInstance } from "../../../lib/pagebuilder/schema";

interface Props {
  block: BlockInstance;
}

const { block } = Astro.props;
const content = block.content || {};

const defaultArticles = [
  {
    title: "Why Hanuman Chalisa Has Exactly 40 Verses",
    slug: "significance-of-forty-verses",
    readTime: "4 min read",
    excerpt: "Explore the astronomical, biological, and scriptural significance of the number 40 in the Hanuman Chalisa.",
  },
  {
    title: "Brahma Muhurat Recitation Hours & Spiritual Benefits",
    slug: "brahma-muhurat-recitation-hours",
    readTime: "5 min read",
    excerpt: "Discover why chanting sacred hymns during Brahma Muhurat yields amplified focus and divine peace.",
  },
  {
    title: "108 Names of Lord Hanuman (Ashtottara Shatanamavali)",
    slug: "108-names-of-hanuman-meaning",
    readTime: "6 min read",
    excerpt: "Sacred names of Bajrangbali with Devanagari lyrics and English philosophical breakdowns.",
  },
];

const articles = content.articles && content.articles.length > 0 ? content.articles : defaultArticles;
---

<!-- Block: Related Articles -->
<section id={block.id} class="related-articles-block space-y-6 max-w-5xl mx-auto py-8">
  <div class="flex items-center justify-between border-b border-[#C9A45C]/25 pb-3">
    <div class="space-y-1">
      <span class="text-xs font-bold uppercase tracking-widest text-[#C95716]">
        Recommended Reading
      </span>
      <h3 class="font-serif-display text-xl sm:text-2xl font-bold text-[#4A1216]">
        {content.title || "Related Vedic Knowledge & Insights"}
      </h3>
    </div>
    <a href="/blog" class="text-xs font-bold text-[#C95716] hover:underline hidden sm:inline-block">
      View All Articles &rarr;
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {articles.map((art: any) => (
      <a
        href={art.slug ? `/blog/${art.slug}` : (art.url || "/blog")}
        class="group p-5 rounded-xl bg-white border border-[#C9A45C]/30 shadow-xs hover:border-[#C9A45C] hover:shadow-md transition-all flex flex-col justify-between"
      >
        <div class="space-y-2">
          <span class="text-[11px] font-semibold text-[#4A1216] bg-[#C9A45C]/15 px-2.5 py-0.5 rounded-full inline-block">
            {art.readTime || "Read Article"}
          </span>
          <h4 class="font-serif-display text-base font-bold text-[#4A1216] group-hover:text-[#C95716] transition-colors leading-snug">
            {art.title}
          </h4>
          <p class="text-xs text-[#34251D]/75 leading-relaxed line-clamp-3">
            {art.excerpt}
          </p>
        </div>
        <span class="mt-4 text-xs font-semibold text-[#C95716] group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
          Read Story &rarr;
        </span>
      </a>
    ))}
  </div>
</section>

              सस्वर पाठ सुनें &rarr;
            </div>
          </a>

          <a
            href="/hanuman-chalisa-pdf"
            class="group p-6 hover:bg-[#F2EAE0] transition-colors flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between text-xs text-brass-gold font-bold mb-2">
                <span>साधन ०३</span>
                <span class="text-vermilion group-hover:translate-x-1 transition-transform">→</span>
              </div>
              <h3 class="font-bold font-serif-display text-base text-maroon-deep group-hover:text-vermilion transition-colors">
                Printable Altar PDF Booklet
              </h3>
              <p class="text-xs text-charcoal-brown/75 mt-2 leading-relaxed font-sans">
                High-resolution vector PDF in Hindi, English, and Telugu specifically formatted for home mandir recitation.
              </p>
            </div>
            <div class="mt-5 pt-3 border-t border-brass-gold/20 text-xs font-semibold text-brass-gold group-hover:text-vermilion">
              नित्य पाठ पत्रक डाउनलोड &rarr;

    <!-- SECTION 4: Featured Devotional Chronicles & Gazette (ज्ञान गंगा) -->
    <section class="max-w-6xl mx-auto px-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-8 pb-3 border-b border-brass-gold/30 gap-4">
        <div class="space-y-1">
          <span class="rubric-marker">
            <span>— चतुर्थ प्रभाग : शोध एवं आध्यात्मिक आलेख —</span>
          </span>
          <h2 class="text-2xl sm:text-3xl font-serif-display font-bold text-maroon-deep">

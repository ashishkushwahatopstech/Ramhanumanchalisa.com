---
import Layout from "../layouts/Layout.astro";
import { getChalisaData } from "../lib/getChalisaData";
import ChalisaTemplate from "../components/ChalisaTemplate";
import LanguageBanner from "../components/LanguageBanner";
import CookieRedirect from "../components/CookieRedirect";
import DiyaCounter from "../components/DiyaCounter";
import PageFaqs from "../components/PageFaqs.astro";

const db = Astro.locals.runtime?.env?.DB;
const data = await getChalisaData("hi", db);

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Ram Hanuman Chalisa",
  "url": "https://ramhanumanchalisa.com/",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://ramhanumanchalisa.com/?s={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Ram Hanuman Chalisa",
  "url": "https://ramhanumanchalisa.com/",
  "logo": "https://ramhanumanchalisa.com/icon.png",
  "sameAs": [
    "https://www.instagram.com/ramhanumanchalisadotcom/"
  ]
};
const pageTitle = "Hanuman Chalisa Lyrics with Meaning | Ram Hanuman Chalisa";
const pageDescription = "Read Hanuman Chalisa lyrics with meaning in Hindi & English. Listen to audio, explore path vidhi, and download free PDF.";
---

<Layout title={pageTitle} description={pageDescription} showHreflangs={true} lang="hi">
  <!-- Brand Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <CookieRedirect client:idle />
  <LanguageBanner client:idle />

  <div class="space-y-16">
    <!-- Primary Scripture Recitation (Hanuman Chalisa 40 Verses) -->
    <ChalisaTemplate data={data} isHomepage={true} />

    <!-- Interactive Ambient Puja & Japa Counter -->
    <div class="py-8 border-y border-brass-gold/25 bg-[#F6EFE3]">
      <DiyaCounter client:visible />
    </div>

    <!-- SECTION 1: Sacred Stotras & Chalisas Hub (Illuminated Treasury) -->

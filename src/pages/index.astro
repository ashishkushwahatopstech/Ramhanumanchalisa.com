          <div class="mt-4 pt-3 border-t border-brass-gold/20 flex items-center gap-2 text-xs text-maroon-deep/80">
            <span>📖 40 Chaupai</span>
            <span>•</span>
            <span>🕊️ Maryada Purushottam</span>
          </div>
        </a>

        <!-- Bajrang Baan Card -->
        <a
          href="/bajrang-baan"
          class="group p-5 bg-stone-ivory border border-brass-gold/40 rounded-xl shadow-sm hover:shadow-md hover:border-marigold hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between">

---
import Layout from "../layouts/Layout.astro";
import { getChalisaData } from "../lib/getChalisaData";
import ChalisaTemplate from "../components/ChalisaTemplate";
import LanguageBanner from "../components/LanguageBanner";
import CookieRedirect from "../components/CookieRedirect";
import DiyaCounter from "../components/DiyaCounter";
import PageFaqs from "../components/PageFaqs.astro";

const db = Astro.locals.runtime?.env?.DB;
const data = await getChalisaData("hi", db);

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Ram Hanuman Chalisa",
  "url": "https://ramhanumanchalisa.com",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://ramhanumanchalisa.com/?s={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Ram Hanuman Chalisa",
  "url": "https://ramhanumanchalisa.com",
  "logo": "https://ramhanumanchalisa.com/icon.png"
};
const pageTitle = "Shree Hanuman Chalisa — Lyrics, Meaning, Audio & PDF";
const pageDescription = "Read authentic Shree Hanuman Chalisa in Hindi and English with line-by-line meaning, synced MP3 audio, printable PDF, and complete path vidhi guidelines.";
---

<Layout title={pageTitle} description={pageDescription} showHreflangs={true}>
  <!-- Brand Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <CookieRedirect client:load />
  <LanguageBanner client:load />

  <div class="space-y-16">
    <!-- Primary Scripture Recitation (Hanuman Chalisa 40 Verses) -->
    <ChalisaTemplate data={data} isHomepage={true} client:load />

    <!-- Interactive Ambient Puja & Japa Counter -->
    <div class="py-8 border-t border-b border-brass-gold/30 bg-gradient-to-r from-transparent via-marigold/10 to-transparent">
      <DiyaCounter client:load />
    </div>

    <!-- SECTION 1: Sacred Stotras & Chalisas Hub -->
    <section class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-8">
        <span class="text-xs uppercase font-bold tracking-widest text-brass-gold bg-maroon-deep/10 px-3 py-1 rounded-full border border-brass-gold/30">
          Sacred Scriptures
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif-display font-bold text-maroon-deep mt-2">
          सम्पूर्ण स्तोत्र एवं चालीसा संग्रह
        </h2>
        <p class="text-xs sm:text-sm text-charcoal-brown/80 max-w-xl mx-auto mt-1 font-serif">
          Recite timeless Vedic and Awadhi prayers dedicated to Lord Rama and Mahavira Hanuman with authentic lyrics and translations.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- Ram Chalisa Card -->
        <a
          href="/ram-chalisa"
          class="group p-5 bg-stone-ivory border border-brass-gold/40 rounded-xl shadow-sm hover:shadow-md hover:border-marigold hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-vermilion bg-marigold/20 px-2 py-0.5 rounded border border-marigold/40">श्री राम</span>
              <span class="text-stone-ivory/80 group-hover:translate-x-1 transition-transform text-xs text-brass-gold font-bold">Explore →</span>
            </div>
            <h3 class="text-lg font-bold font-serif-display text-maroon-deep mt-3 group-hover:text-vermilion transition-colors">
              Shree Ram Chalisa (श्री राम चालीसा)
            </h3>
            <p class="text-xs text-charcoal-brown/80 mt-1.5 leading-relaxed font-serif">
              Complete 40 chaupais of Bhagwan Shri Ram Chandra with verse translations, benefits, and printable layout.

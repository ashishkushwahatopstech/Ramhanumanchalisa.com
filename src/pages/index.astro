---
import Layout from "../layouts/Layout.astro";
import { getChalisaData } from "../lib/getChalisaData";
import ChalisaTemplate from "../components/ChalisaTemplate";
import LanguageBanner from "../components/LanguageBanner";
import CookieRedirect from "../components/CookieRedirect";
import DiyaCounter from "../components/DiyaCounter";
import PageFaqs from "../components/PageFaqs.astro";

const db = Astro.locals.runtime?.env?.DB;
const data = await getChalisaData("hi", db);

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Ram Hanuman Chalisa",
  "url": "https://ramhanumanchalisa.com",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://ramhanumanchalisa.com/?s={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Ram Hanuman Chalisa",
  "url": "https://ramhanumanchalisa.com",
  "logo": "https://ramhanumanchalisa.com/icon.png"
};
const pageTitle = "Shree Hanuman Chalisa — Lyrics, Meaning, Audio & PDF";
const pageDescription = "Read authentic Shree Hanuman Chalisa in Hindi and English with line-by-line meaning, synced MP3 audio, printable PDF, and complete path vidhi guidelines.";
---

<Layout title={pageTitle} description={pageDescription} showHreflangs={true}>
  <!-- Brand Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

  <CookieRedirect client:load />
  <LanguageBanner client:load />

  <div class="space-y-16">
    <!-- Primary Scripture Recitation (Hanuman Chalisa 40 Verses) -->
    <ChalisaTemplate data={data} isHomepage={true} client:load />

    <!-- Interactive Ambient Puja & Japa Counter -->
    <div class="py-8 border-y border-brass-gold/25 bg-[#F6EFE3]">
      <DiyaCounter client:load />
    </div>

    <!-- SECTION 1: Sacred Stotras & Chalisas Hub (Illuminated Treasury) -->
    <section class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-8 space-y-2">
        <div class="flex justify-center">
          <span class="rubric-marker">
            <span>— प्रथम प्रभाग : संपूर्ण स्तोत्र एवं चालीसा संग्रह —</span>
          </span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-serif-display font-bold text-maroon-deep">
          सम्पूर्ण स्तोत्र एवं चालीसा संग्रह
        </h2>
        <p class="text-xs sm:text-sm text-charcoal-brown/75 max-w-xl mx-auto font-sans leading-relaxed">
          Recite timeless Vedic and Awadhi prayers dedicated to Lord Rama and Mahavira Hanuman with authentic lyrics, word breakdowns, and verified translations.
        </p>
      </div>

      <div class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <a
            href="/ram-chalisa"
            class="group manuscript-frame p-6 sm:p-8 flex flex-col justify-between hover:border-brass-gold transition-colors"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs">
                <span class="rubric-marker !py-0.5">॥ मर्यादा पुरुषोत्तम ॥</span>
                <span class="text-xs text-brass-gold font-bold font-mono">४० चौपाई • ४ दोहे</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-serif-display font-bold text-maroon-deep group-hover:text-vermilion transition-colors">
                Shree Ram Chalisa (श्री राम चालीसा)
              </h3>
              <p class="text-xs sm:text-sm text-charcoal-brown/80 leading-relaxed font-sans">
                The authentic 40 chaupais revering Bhagwan Shri Ram Chandra, celebrating his righteous reign (Ram Rajya), gentle compassion, and supreme protection with complete verse translations.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-brass-gold/25 flex items-center justify-between text-xs font-semibold text-maroon-deep">
              <span class="text-brass-gold group-hover:text-vermilion transition-colors">Explore Lyrics & Meaning</span>
              <span class="text-vermilion group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>

          <a
            href="/bajrang-baan"
            class="group manuscript-frame p-6 sm:p-8 flex flex-col justify-between hover:border-brass-gold transition-colors"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs">
                <span class="rubric-marker !py-0.5">॥ अमोघ रक्षा कवच ॥</span>
                <span class="text-xs text-brass-gold font-bold font-mono">तांत्रिक रक्षा स्तोत्र</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-serif-display font-bold text-maroon-deep group-hover:text-vermilion transition-colors">
                Shree Bajrang Baan (श्री बजरंग बाण)
              </h3>
              <p class="text-xs sm:text-sm text-charcoal-brown/80 leading-relaxed font-sans">
                The invincible protection shield hymn invoking the sacred oaths of Lord Rama to dispel severe adversities, negativity, fear, and planetary afflictions.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-brass-gold/25 flex items-center justify-between text-xs font-semibold text-maroon-deep">
              <span class="text-brass-gold group-hover:text-vermilion transition-colors">Recite Sacred Oaths</span>
              <span class="text-vermilion group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        </div>

        <div class="manuscript-frame overflow-hidden">
          <div class="px-5 py-3.5 bg-[#F3ECE0] border-b border-brass-gold/30 flex items-center justify-between">
            <span class="font-serif-display text-xs font-bold uppercase tracking-wider text-maroon-deep flex items-center gap-2">
              <span class="text-vermilion">॥</span>
              <span>सहायक स्तोत्र एवं नित्य अर्चना सूची</span>
            </span>
            <span class="text-[11px] text-charcoal-brown/60 hidden sm:inline">
              Classical Awadhi & Sanskrit Hymns
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-brass-gold/20 bg-[#FAF6EE]">
            <a
              href="/sankat-mochan-hanumanashtak"
              class="group p-5 hover:bg-[#F2EAE0] transition-colors flex flex-col justify-between"
            >
              <div>
                <div class="text-[10px] text-brass-gold font-bold uppercase tracking-wider mb-1">
                  स्तोत्र ०१
                </div>
                <h4 class="font-serif-display font-bold text-sm text-maroon-deep group-hover:text-vermilion transition-colors">
                  Sankat Mochan (संकटमोचन)
                </h4>
                <p class="text-xs text-charcoal-brown/75 mt-1.5 leading-relaxed">
                  Eight sacred couplets recounting the heroic feats of Mahavira.
                </p>
              </div>
              <div class="mt-4 pt-2 border-t border-brass-gold/15 text-[11px] font-semibold text-vermilion flex items-center justify-between">
                <span>८ पद • सस्वर पाठ</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>

            <a
              href="/hanuman-aarti"
              class="group p-5 hover:bg-[#F2EAE0] transition-colors flex flex-col justify-between"
            >
              <div>
                <div class="text-[10px] text-brass-gold font-bold uppercase tracking-wider mb-1">
                  स्तोत्र ०२
                </div>
                <h4 class="font-serif-display font-bold text-sm text-maroon-deep group-hover:text-vermilion transition-colors">
                  Hanuman Aarti (संध्या आरती)
                </h4>
                <p class="text-xs text-charcoal-brown/75 mt-1.5 leading-relaxed">
                  Traditional mandir twilight prayer &ldquo;Aarti Kije Hanuman Lala Ki&rdquo;.
                </p>
              </div>
              <div class="mt-4 pt-2 border-t border-brass-gold/15 text-[11px] font-semibold text-vermilion flex items-center justify-between">
                <span>आरती • कपूर ज्योति</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>

            <a
              href="/hanuman-stuti"
              class="group p-5 hover:bg-[#F2EAE0] transition-colors flex flex-col justify-between"
            >
              <div>
                <div class="text-[10px] text-brass-gold font-bold uppercase tracking-wider mb-1">
                  स्तोत्र ०३
                </div>
                <h4 class="font-serif-display font-bold text-sm text-maroon-deep group-hover:text-vermilion transition-colors">
                  Hanuman Stuti (स्तुति)
                </h4>
                <p class="text-xs text-charcoal-brown/75 mt-1.5 leading-relaxed">
                  Classical Awadhi-Sanskrit verses revering matchless strength and bhakti.
                </p>
              </div>
              <div class="mt-4 pt-2 border-t border-brass-gold/15 text-[11px] font-semibold text-vermilion flex items-center justify-between">
                <span>भक्ति स्तुति • वन्दना</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>

            <a
              href="/ram-hanuman-chalisa"
              class="group p-5 hover:bg-[#F2EAE0] transition-colors flex flex-col justify-between"
            >
              <div>
                <div class="text-[10px] text-brass-gold font-bold uppercase tracking-wider mb-1">
                  तत्त्व ०४
                </div>
                <h4 class="font-serif-display font-bold text-sm text-maroon-deep group-hover:text-vermilion transition-colors">
                  Ram-Hanuman Bond (संबंध)
                </h4>
                <p class="text-xs text-charcoal-brown/75 mt-1.5 leading-relaxed">
                  The metaphysical key linking Rama&apos;s holy name with Hanuman&apos;s grace.
                </p>
              </div>
              <div class="mt-4 pt-2 border-t border-brass-gold/15 text-[11px] font-semibold text-vermilion flex items-center justify-between">
                <span>भक्ति तत्त्व • रहस्य</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2: Regional Language Editions (Multilingual Script Pavilion) -->
    <section class="max-w-6xl mx-auto px-4">
      <div class="manuscript-frame overflow-hidden">
        <div class="p-6 sm:p-8 text-center border-b border-brass-gold/30 bg-[#F4EDE0] space-y-2">
          <div class="flex justify-center">
            <span class="rubric-marker">
              <span>— द्वितीय प्रभाग : बहुभाषिक लिपि मण्डप —</span>
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-serif-display font-bold text-maroon-deep">
            Regional Language Editions & Sacred Scripts
          </h2>
          <p class="text-xs sm:text-sm text-charcoal-brown/75 max-w-xl mx-auto font-sans leading-relaxed">
            Read the Shree Hanuman Chalisa in your mother tongue with synchronized audio recitations, authentic translations, and downloadable PDF sheets.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 divide-y sm:divide-y-0 divide-x divide-brass-gold/25 bg-[#FAF6EE]">
          <a
            href="/hanuman-chalisa/te"
            class="group p-5 hover:bg-[#F2EAE0] transition-colors flex flex-col items-center justify-between text-center min-h-[150px]"
            aria-label="Read Shree Hanuman Chalisa in Telugu"
          >
            <div>
              <div class="text-2xl font-serif text-maroon-deep/80 group-hover:scale-110 transition-transform mb-1">
                తెలుగు
              </div>
              <div class="font-serif-display font-bold text-sm text-maroon-deep group-hover:text-vermilion">
                Telugu
              </div>
              <div class="text-[11px] text-charcoal-brown/70 mt-1">
                శ్రీ హనుమాన్ చాలీసా
              </div>
            </div>
            <span class="text-[11px] font-semibold text-vermilion mt-3 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              <span>పఠించండి</span>
              <span>&rarr;</span>
            </span>
          </a>

          <a
            href="/hanuman-chalisa/kn"
            class="group p-5 hover:bg-[#F2EAE0] transition-colors flex flex-col items-center justify-between text-center min-h-[150px]"
            aria-label="Read Shree Hanuman Chalisa in Kannada"
          >
            <div>
              <div class="text-2xl font-serif text-maroon-deep/80 group-hover:scale-110 transition-transform mb-1">
                ಕನ್ನಡ
              </div>
              <div class="font-serif-display font-bold text-sm text-maroon-deep group-hover:text-vermilion">
                Kannada
              </div>
              <div class="text-[11px] text-charcoal-brown/70 mt-1">
                ಶ್ರೀ ಹನುಮಾನ್ ಚಾಲೀಸಾ
              </div>
            </div>
            <span class="text-[11px] font-semibold text-vermilion mt-3 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              <span>ಓದಿರಿ</span>
              <span>&rarr;</span>
            </span>
          </a>

          <a
            href="/hanuman-chalisa/gu"
            class="group p-5 hover:bg-[#F2EAE0] transition-colors flex flex-col items-center justify-between text-center min-h-[150px]"
            aria-label="Read Shree Hanuman Chalisa in Gujarati"
          >
            <div>
              <div class="text-2xl font-serif text-maroon-deep/80 group-hover:scale-110 transition-transform mb-1">
                ગુજરાતી
              </div>
              <div class="font-serif-display font-bold text-sm text-maroon-deep group-hover:text-vermilion">
                Gujarati
              </div>
              <div class="text-[11px] text-charcoal-brown/70 mt-1">
                શ્રી હનુમાન ચાલીસા
              </div>
            </div>
            <span class="text-[11px] font-semibold text-vermilion mt-3 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              <span>વાંચો</span>
              <span>&rarr;</span>
            </span>
          </a>

          <a
            href="/hanuman-chalisa/mr"
            class="group p-5 hover:bg-[#F2EAE0] transition-colors flex flex-col items-center justify-between text-center min-h-[150px]"
            aria-label="Read Shree Hanuman Chalisa in Marathi"
          >
            <div>
              <div class="text-2xl font-serif text-maroon-deep/80 group-hover:scale-110 transition-transform mb-1">

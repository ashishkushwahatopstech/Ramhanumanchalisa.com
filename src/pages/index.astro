              </div>
              <div class="font-serif-display font-bold text-sm text-maroon-deep group-hover:text-vermilion">
                Marathi
              </div>
              <div class="text-[11px] text-charcoal-brown/70 mt-1">
                श्री हनुमान चालीसा
              </div>
            </div>
            <span class="text-[11px] font-semibold text-vermilion mt-3 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              <span>वाचा</span>
              <span>&rarr;</span>
            </span>
          </a>

          <a
            href="/hanuman-chalisa/bn"
            class="group p-5 hover:bg-[#F2EAE0] transition-colors flex flex-col items-center justify-between text-center min-h-[150px]"
            aria-label="Read Shree Hanuman Chalisa in Bengali"
          >
            <div>
              <div class="text-2xl font-serif text-maroon-deep/80 group-hover:scale-110 transition-transform mb-1">
                বাংলা
              </div>
              <div class="font-serif-display font-bold text-sm text-maroon-deep group-hover:text-vermilion">
                Bengali
              </div>
              <div class="text-[11px] text-charcoal-brown/70 mt-1">
                শ্রী হনুমান চালীসা
              </div>
            </div>
            <span class="text-[11px] font-semibold text-vermilion mt-3 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              <span>পাঠ করুন</span>
              <span>&rarr;</span>
            </span>
          </a>

          <a
            href="/hanuman-chalisa/en"
            class="group p-5 hover:bg-[#F2EAE0] transition-colors flex flex-col items-center justify-between text-center min-h-[150px]"
            aria-label="Read Shree Hanuman Chalisa in English"
          >
            <div>
              <div class="text-2xl font-serif text-maroon-deep/80 group-hover:scale-110 transition-transform mb-1">
                English
              </div>
              <div class="font-serif-display font-bold text-sm text-maroon-deep group-hover:text-vermilion">
                English
              </div>
              <div class="text-[11px] text-charcoal-brown/70 mt-1">
                With Translation
              </div>
            </div>
            <span class="text-[11px] font-semibold text-vermilion mt-3 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform">
              <span>Read Translation</span>
              <span>&rarr;</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- SECTION 3: Mandir Sadhana & Chanting Utilities (Altar Bench) -->
    <section class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-8 space-y-2">
        <div class="flex justify-center">
          <span class="rubric-marker">
            <span>— तृतीय प्रभाग : नित्य साधना एवं अध्ययन पीठ —</span>
          </span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-serif-display font-bold text-maroon-deep">
          पूजा एवं साधना साधन • Altar Instruments
        </h2>
        <p class="text-xs sm:text-sm text-charcoal-brown/75 max-w-xl mx-auto font-sans leading-relaxed">
          Sacred study aids and ritual instruments designed to deepen your daily recitation discipline, pronunciation, and understanding.
        </p>
      </div>

      <div class="manuscript-frame overflow-hidden">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-brass-gold/25 bg-[#FAF6EE]">
          <a
            href="/hanuman-chalisa-meaning"
            class="group p-6 hover:bg-[#F2EAE0] transition-colors flex flex-col justify-between"
          >

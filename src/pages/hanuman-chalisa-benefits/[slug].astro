---
import Layout from "../../layouts/Layout.astro";
import CarvedDivider from "../../components/CarvedDivider";
import { BENEFITS_DATA } from "../../data/benefits";

const { slug } = Astro.params;

if (!slug || !BENEFITS_DATA[slug]) {
  return Astro.redirect("/404");
}

const benefit = BENEFITS_DATA[slug];

// Get other benefits to display in the sidebar
const otherBenefits = Object.values(BENEFITS_DATA).filter(
  (b) => b.slug !== slug
);

const title = `${benefit.title} — Hanuman Chalisa Chanting Guide`;
const description = `Learn how chanting Hanuman Chalisa Chaupai ${benefit.targetVerseNumber} resolves issues with ${benefit.situation}. Recommended schedules and step-by-step guidelines.`;
---

<Layout title={title} description={description}>
  <div class="space-y-10 max-w-5xl mx-auto">
    
    <!-- Breadcrumbs -->
    <nav class="text-xs text-charcoal-brown/50 font-semibold" aria-label="Breadcrumb">
      <ol class="list-none p-0 inline-flex gap-2">
        <li class="flex items-center">
          <a href="/" class="hover:text-maroon-deep">Home</a>
          <span class="mx-2">/</span>
        </li>
        <li class="flex items-center">
          <a href="/hanuman-chalisa-benefits" class="hover:text-maroon-deep">Benefits</a>
          <span class="mx-2">/</span>
        </li>
        <li class="text-maroon-deep truncate max-w-[200px]" aria-current="page">
          {benefit.title.split(" — ")[0]}
        </li>
      </ol>
    </nav>

    <!-- Main Content Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Detail Column -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Header Block -->
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <span class="text-4xl p-3 bg-marigold/15 rounded-full border border-marigold/30">
              {benefit.icon}
            </span>
            <h2 class="font-serif-display text-2xl sm:text-3xl font-bold text-maroon-deep leading-tight">
              {benefit.title}
            </h2>
          </div>
          <p class="text-sm font-bold text-brass-gold uppercase tracking-wider">
            Life Challenge: {benefit.situation}
          </p>
          <p class="text-sm sm:text-base text-charcoal-brown/90 leading-relaxed">
            {benefit.description}
          </p>
        </div>

        <CarvedDivider icon="🕉️" />

        <!-- Connected Verse Box (The core focal point) -->
        <div class="p-6 sm:p-8 bg-maroon-deep text-stone-ivory border-2 border-brass-gold rounded-lg shadow-md space-y-4 text-center">
          <span class="text-xs uppercase font-bold tracking-widest text-marigold">
            Focal Verse for Chanting (Chaupai {benefit.targetVerseNumber})
          </span>
          <p class="font-hindi-display text-xl sm:text-2xl md:text-3xl leading-loose font-bold tracking-wide">
            {benefit.targetVerseText}
          </p>
          <p class="text-xs sm:text-sm italic text-stone-ivory/70 max-w-xl mx-auto">
            {benefit.targetVerseTranslation}
          </p>
        </div>

        <!-- Detailed Exposition -->
        <div class="space-y-4">
          <h3 class="font-serif-display text-lg text-maroon-deep uppercase tracking-wider font-bold border-b border-brass-gold/20 pb-2">
            Spiritual Explanation & Significance
          </h3>
          <p class="text-sm sm:text-base text-charcoal-brown/90 leading-relaxed whitespace-pre-line">
            {benefit.detailedExposition}
          </p>
        </div>

        <!-- Step-by-Step Puja Vidhi Guide -->
        <div class="bg-stone-ivory border border-brass-gold/30 p-6 sm:p-8 rounded-lg shadow-sm space-y-6">
          <div class="space-y-1">
            <h3 class="font-serif-display text-lg text-maroon-deep uppercase tracking-wider font-bold">
              Recitation Schedule & Rituals (अनुष्ठान विधि)
            </h3>
            <p class="text-xs text-brass-gold font-bold uppercase">
              Recommended: {benefit.recommendedChants}
            </p>
          </div>

          <ol class="relative border-l border-brass-gold/30 ml-4 space-y-6 text-sm text-charcoal-brown/90">
            {benefit.actionSteps.map((step, idx) => (
              <li class="mb-2 ml-6">
                <span class="absolute flex items-center justify-center w-6 h-6 bg-marigold text-maroon-deep rounded-full -left-3 font-bold text-xs shadow-sm select-none border border-brass-gold">
                  {idx + 1}
                </span>
                <p class="leading-relaxed font-semibold">
                  {step}
                </p>
              </li>
            ))}
          </ol>
        </div>

      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        
        <!-- Ad Slot -->
        <div class="no-print w-full h-64 bg-stone-ivory border border-brass-gold/20 flex items-center justify-center text-xs text-charcoal-brown/40 tracking-widest uppercase rounded shadow-inner">
          Ad Slot — Sidebar Sticky
        </div>

        <div class="bg-stone-ivory border border-brass-gold/30 p-6 rounded-lg shadow-sm space-y-4">
          <h4 class="font-serif-display text-sm uppercase tracking-wider font-bold text-maroon-deep border-b border-brass-gold/20 pb-2">
            Other Situations
          </h4>
          
          <div class="space-y-3">
            {otherBenefits.map((b) => (
              <a
                href={`/hanuman-chalisa-benefits/${b.slug}`}
                class="block p-3 border border-brass-gold/15 hover:border-marigold hover:bg-marigold/5 rounded transition-all duration-200"
              >
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-lg">{b.icon}</span>
                  <h5 class="font-serif-display font-bold text-xs sm:text-sm text-maroon-deep uppercase leading-tight">
                    {b.title.split(" for ")[1] || b.title}
                  </h5>
                </div>
                <p class="text-[10px] text-charcoal-brown/60 leading-relaxed truncate">
                  {b.situation}
                </p>
              </a>
            ))}
          </div>
        </div>

      </div>

    </div>

    <!-- AdSense Footer Slot -->
    <div class="no-print w-full h-24 bg-stone-ivory border border-brass-gold/20 flex items-center justify-center text-xs text-charcoal-brown/40 tracking-widest uppercase rounded shadow-inner my-12">
      Ad Slot — Detail Bottom (Layout Stable Skeleton)
    </div>

  </div>
</Layout>

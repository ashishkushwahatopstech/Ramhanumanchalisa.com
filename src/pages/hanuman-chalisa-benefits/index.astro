---
import Layout from "../../layouts/Layout.astro";
import CarvedDivider from "../../components/CarvedDivider";
import { getPrisma } from "../../lib/prisma";
import { BENEFITS_DATA, type BenefitDetails } from "../../data/benefits";

const db = Astro.locals.runtime?.env?.DB;
const prisma = getPrisma(db);

let allBenefits: BenefitDetails[] = Object.values(BENEFITS_DATA);

try {
  const dbBenefits = await prisma.benefit.findMany({
    where: { published: true },
    orderBy: { createdAt: "desc" },
  });

  if (dbBenefits.length > 0) {
    const dbList: BenefitDetails[] = dbBenefits.map((b) => ({
      slug: b.slug,
      title: b.title,
      situation: b.situation,
      icon: b.icon || "🙏",
      description: b.description,
      recommendedChants: b.recommendedChants || "Read daily",
      targetVerseNumber: b.targetVerseNumber || 1,
      targetVerseText: b.targetVerseText || "",
      targetVerseTranslation: b.targetVerseTranslation || "",
      detailedExposition: b.detailedExposition,
      actionSteps: b.actionSteps ? JSON.parse(b.actionSteps) : [],
    }));

    // Merge: DB items take precedence, non-colliding static items remain
    const staticFiltered = Object.values(BENEFITS_DATA).filter(
      (s) => !dbList.some((d) => d.slug === s.slug)
    );
    allBenefits = [...dbList, ...staticFiltered];
  }
} catch (error) {
  console.error("Error reading benefits from DB for index:", error);
}

const title = "Hanuman Chalisa Benefits — Recitation Advantages by Life Situation";
const description = "Discover the spiritual, psychological, and physical benefits of reciting Hanuman Chalisa. Situation-based guides for career, health, studies, and protection.";
---

<Layout title={title} description={description}>
  <div class="space-y-10 max-w-5xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-charcoal-brown/50 font-semibold" aria-label="Breadcrumb">
      <ol class="list-none p-0 inline-flex gap-2">
        <li class="flex items-center">
          <a href="/" class="hover:text-maroon-deep">Home</a>
          <span class="mx-2">/</span>
        </li>
        <li class="text-maroon-deep truncate max-w-[200px]" aria-current="page">
          Benefits
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <div class="text-center space-y-3">
      <span class="text-xs font-bold tracking-widest text-maroon-deep bg-marigold/30 px-3 py-1 rounded border border-marigold">
        Spiritual Power (फलश्रुति)
      </span>
      <h1 class="font-serif-display text-3xl uppercase tracking-wider font-bold text-maroon-deep">
        Hanuman Chalisa Benefits & Blessings
      </h1>
      <p class="text-xs text-charcoal-brown/70 max-w-2xl mx-auto leading-relaxed">
        Reciting the Hanuman Chalisa brings spiritual strength, peace, and protection. Devotees chant specific verses to focus on career growth, physical healing, studies, protection from negative energies, or relationship harmony.
      </p>
    </div>

    <CarvedDivider icon="✨" />

    <!-- AdSense Top Slot -->
    <div class="no-print w-full h-24 bg-stone-ivory border border-brass-gold/20 flex items-center justify-center text-xs text-charcoal-brown/40 tracking-widest uppercase rounded shadow-inner">
      Ad Slot — Page Top (Layout Stable Skeleton)
    </div>

    <!-- Grid of Benefit Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {allBenefits.map((benefit) => (
        <div
          class="p-6 bg-stone-ivory border border-brass-gold/30 hover:border-marigold rounded-lg shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between space-y-4"
        >
          <div class="space-y-3">
            <div class="flex items-center gap-3">
              <span class="text-3xl p-2 bg-marigold/10 rounded-full border border-marigold/20">
                {benefit.icon}
              </span>
              <h3 class="font-serif-display text-lg font-bold text-maroon-deep leading-snug">
                {benefit.title}
              </h3>
            </div>
            
            <p class="text-xs text-brass-gold uppercase font-bold tracking-wider">
              Focus: {benefit.situation}
            </p>
            
            <p class="text-xs sm:text-sm text-charcoal-brown/85 leading-relaxed line-clamp-3">
              {benefit.description}
            </p>
          </div>

          <div class="pt-2 border-t border-brass-gold/10 flex justify-between items-center">
            <span class="text-[10px] font-bold text-charcoal-brown/50">
              Chaupai {benefit.targetVerseNumber} Reference
            </span>
            <a
              href={`/hanuman-chalisa-benefits/${benefit.slug}`}
              class="bg-vermilion hover:bg-marigold text-stone-ivory hover:text-maroon-deep px-4 py-1.5 rounded text-xs font-bold uppercase border border-brass-gold shadow-sm transition-colors duration-200"
            >
              Read Guide &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>

    <CarvedDivider icon="🕉️" />

    <!-- General Benefits Summary -->
    <section class="bg-maroon-deep text-stone-ivory border-2 border-brass-gold p-8 rounded-lg space-y-6">
      <h3 class="font-serif-display text-xl text-marigold uppercase tracking-wider text-center font-bold">
        Why Recite Hanuman Chalisa Daily?
      </h3>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm leading-relaxed text-stone-ivory/90">
        <div class="space-y-2">
          <h4 class="font-bold text-marigold uppercase tracking-wide">
            1. Overcoming Shani (Saturn) Influence
          </h4>
          <p class="text-xs text-stone-ivory/80">
            According to scriptures, Lord Saturn (Shani Dev) promised Lord Hanuman that he would never trouble Hanuman's devotees. Chanting the Chalisa on Tuesdays and Saturdays protects devotees from the harsh phases of Saturn (Sade Sati, Dhayya).
          </p>
        </div>

        <div class="space-y-2">
          <h4 class="font-bold text-marigold uppercase tracking-wide">
            2. Cultivating Humility (Bhakti)
          </h4>
          <p class="text-xs text-stone-ivory/80">
            Despite having immeasurable strength, Hanuman is the epitome of absolute humility and devotion to Lord Rama. Reciting his verses eliminates ego, helps control anger, and opens the heart to devotion and kindness.
          </p>
        </div>
      </div>
    </section>

    <!-- AdSense Footer Slot -->
    <div class="no-print w-full h-24 bg-stone-ivory border border-brass-gold/20 flex items-center justify-center text-xs text-charcoal-brown/40 tracking-widest uppercase rounded shadow-inner my-12">
      Ad Slot — Benefits Page Bottom (Layout Stable Skeleton)
    </div>
  </div>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import AartiClient from "../components/AartiClient";
import PageFaqs from "../components/PageFaqs.astro";

const title = "Shree Hanuman Aarti — Lyrics in English, Hindi & Full Translation";
const description = "Chant Shree Hanuman Aarti (Aarti Kije Hanuman Lala Ki). Listen to the synced audio track, check composition details, benefits, and recitation guide.";
---

<Layout title={title} description={description}>
  <div class="space-y-10 max-w-4xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-charcoal-brown/50 font-semibold" aria-label="Breadcrumb">
      <ol class="list-none p-0 inline-flex gap-2">
        <li class="flex items-center">
          <a href="/" class="hover:text-maroon-deep">Home</a>
          <span class="mx-2">/</span>
        </li>
        <li class="text-maroon-deep truncate max-w-[200px]" aria-current="page">
          Hanuman Aarti
        </li>
      </ol>
    </nav>

    <AartiClient client:load />

    <!-- Reusable Dynamic Page FAQs -->
    <PageFaqs
      pageSlug="aarti"
      altSlugs={["hanuman-aarti"]}
      title="Hanuman Aarti FAQs"
    />
  </div>
</Layout>

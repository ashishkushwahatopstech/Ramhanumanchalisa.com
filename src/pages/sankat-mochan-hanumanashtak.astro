---
import Layout from "../layouts/Layout.astro";
import HanumanashtakClient from "../components/HanumanashtakClient";
import PageFaqs from "../components/PageFaqs.astro";
import hanumanashtakData from "../data/scriptures/sankat-mochan-hanumanashtak.json";
import type { ScriptureVerse } from "../types/scripture";

const verses = hanumanashtakData as ScriptureVerse[];

const title = "Sankat Mochan Hanuman Ashtak — Lyrics, Meaning & Audio";
const description = "Read complete Sankat Mochan Hanuman Ashtak lyrics in Hindi and English with line-by-line meaning, synchronized audio by Hariharan, and printable PDF.";
---

<Layout title={title} description={description}>
  <div class="space-y-10 max-w-4xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-charcoal-brown/50 font-semibold" aria-label="Breadcrumb">
      <ol class="list-none p-0 inline-flex gap-2">
        <li class="flex items-center">
          <a href="/" class="hover:text-maroon-deep">Home</a>
          <span class="mx-2">/</span>
        </li>
        <li class="text-maroon-deep truncate max-w-[200px]" aria-current="page">
          Hanuman Ashtak
        </li>
      </ol>
    </nav>

    <HanumanashtakClient verses={verses} client:load />

    <!-- Reusable Dynamic Page FAQs -->
    <PageFaqs
      pageSlug="hanumanashtak"
      altSlugs={["sankat-mochan-hanumanashtak"]}
      title="Hanuman Ashtak FAQs"
    />
  </div>
</Layout>

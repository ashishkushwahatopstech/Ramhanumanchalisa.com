---
import Layout from "../layouts/Layout.astro";
import CarvedDivider from "../components/CarvedDivider";

const title = "Contact Us — Feedback & Devotional Queries";
const description = "Get in touch with the team at RamHanumanChalisa.com for feedback, text corrections, or scholarly submissions.";
---

<Layout title={title} description={description}>
  <div class="space-y-10 max-w-2xl mx-auto">
    
    <!-- Breadcrumbs -->
    <nav class="text-xs text-charcoal-brown/50 font-semibold" aria-label="Breadcrumb">
      <ol class="list-none p-0 inline-flex gap-2">
        <li class="flex items-center">
          <a href="/" class="hover:text-maroon-deep">Home</a>
          <span class="mx-2">/</span>
        </li>
        <li class="text-maroon-deep truncate max-w-[200px]" aria-current="page">
          Contact
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <div class="text-center space-y-3">
      <span class="text-xs font-bold tracking-widest text-maroon-deep bg-marigold/30 px-3 py-1 rounded border border-marigold">
        Get in Touch (संपर्क)
      </span>
      <h1 class="font-serif-display text-3xl uppercase tracking-wider font-bold text-maroon-deep">
        Contact Us
      </h1>
      <p class="text-xs text-charcoal-brown/70 leading-relaxed">
        Have feedback on our synced audio? Spotted a spelling error in the Devanagari Unicode? Want to submit a scholar review? We welcome your input.
      </p>
    </div>

    <CarvedDivider icon="✉️" />

    <!-- Form / Contacts -->
    <section class="bg-stone-ivory border border-brass-gold/30 p-6 sm:p-8 rounded-lg shadow-sm space-y-6">
      <div class="space-y-4">
        <div class="flex flex-col gap-1">
          <h4 class="font-bold text-maroon-deep uppercase tracking-wider text-xs">
            Email Correspondence
          </h4>
          <p class="text-sm font-semibold text-brass-gold select-all">
            support@ramhanumanchalisa.com
          </p>
          <p class="text-xs text-charcoal-brown/60 leading-relaxed">
            We typically respond to spiritual and technical queries within 48 hours.
          </p>
        </div>

        <hr class="border-brass-gold/20" />

        <div class="flex flex-col gap-1">
          <h4 class="font-bold text-maroon-deep uppercase tracking-wider text-xs">
            Address (Karyalaya)
          </h4>
          <p class="text-xs text-charcoal-brown/80 leading-relaxed">
            Ram Hanuman Chalisa Devotional Hub<br />
            Varanasi, Uttar Pradesh, India - 221005
          </p>
        </div>
      </div>

      <hr class="border-brass-gold/20" />

      <!-- Devotional Feedback Note -->
      <p class="text-xs text-charcoal-brown/60 italic leading-relaxed text-center">
        &ldquo;Lord Hanuman resides wherever the name of Shri Rama is chanted with pure intention.&rdquo; Thank you for helping us maintain this clean digital mandir.
      </p>
    </section>

  </div>
</Layout>

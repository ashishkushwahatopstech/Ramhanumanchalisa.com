              {/* English Meanings */}
              <div class="space-y-3 bg-stone-ivory/30 p-4 border border-brass-gold/10 rounded">
                <h4 class="font-serif-display text-xs font-bold uppercase tracking-wider text-maroon-deep border-b border-brass-gold/10 pb-1 flex items-center gap-1">
                  🇺🇸 English Meaning
                </h4>
                <div class="space-y-2 text-xs sm:text-sm">
                  <p class="font-semibold text-charcoal-brown">
                    <span class="text-brass-gold text-[10px] uppercase font-bold mr-1 block sm:inline">Literal:</span>
                    {verse.literal_translation.en}
                  </p>
                  <p class="text-charcoal-brown/80 leading-relaxed">
                    <span class="text-brass-gold text-[10px] uppercase font-bold mr-1 block">Exposition:</span>
                    {verse.interpretive_meaning.en}
                  </p>
                </div>
              </div>

              {/* Hindi Meanings */}
              <div class="space-y-3 bg-stone-ivory/30 p-4 border border-brass-gold/10 rounded">
                <h4 class="font-serif-display text-xs font-bold uppercase tracking-wider text-maroon-deep border-b border-brass-gold/10 pb-1 flex items-center gap-1">
                  🇮🇳 हिंदी अर्थ
                </h4>
                <div class="space-y-2 text-xs sm:text-sm">
                  <p class="font-semibold text-charcoal-brown font-hindi-display text-base">
                    <span class="text-brass-gold text-[10px] uppercase font-bold mr-1 font-sans block sm:inline">शब्दार्थ:</span>
                    {verse.literal_translation.hi}
                  </p>
                  <p class="text-charcoal-brown/80 leading-relaxed font-hindi-display text-base">
                    <span class="text-brass-gold text-[10px] uppercase font-bold mr-1 font-sans block">भावार्थ:</span>
                    {verse.interpretive_meaning.hi}
                  </p>
                </div>
              </div>

            </div>

            {/* Word by Word Dictionary */}
            {verse.word_meanings && verse.word_meanings.length > 0 && (
              <details class="group border border-brass-gold/20 rounded bg-stone-ivory/40">
                <summary class="cursor-pointer select-none px-4 py-2.5 font-serif-display text-xs font-bold tracking-widest text-maroon-deep hover:bg-marigold/10 transition-colors uppercase flex justify-between items-center">
                  <span>📚 Word-by-Word Dictionary (शब्दार्थ विश्लेषण)</span>
                  <span class="text-xs group-open:rotate-180 transition-transform duration-200">
                    ▼
                  </span>
                </summary>
                <div class="p-4 border-t border-brass-gold/10 overflow-x-auto">
                  <table class="w-full text-xs text-left border-collapse">
                    <thead>
                      <tr class="border-b border-brass-gold/20 text-brass-gold uppercase tracking-wider">
                        <th class="py-2 font-bold">Word (मूल शब्द)</th>
                        <th class="py-2 font-bold">IAST</th>
                        <th class="py-2 font-bold">Hindi Meaning</th>
                        <th class="py-2 font-bold">English Meaning</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-brass-gold/10 text-charcoal-brown">
                      {verse.word_meanings.map((wm) => (
                        <tr class="hover:bg-marigold/5 transition-colors">
                          <td class="py-2.5 font-bold font-hindi-display text-sm">{wm.word}</td>
                          <td class="py-2.5 italic">{wm.roman}</td>
                          <td class="py-2.5 font-hindi-display text-sm">{wm.meaning.hi}</td>
                          <td class="py-2.5">{wm.meaning.en}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </details>
            )}

            {/* Story / Puranic Legend Section */}
            {verse.story && verse.story.en && (
              <div class="bg-marigold/5 border-l-4 border-marigold p-4 rounded-r text-xs sm:text-sm">
                <h5 class="font-serif-display font-bold uppercase tracking-wider text-maroon-deep mb-1.5 flex items-center gap-1">
                  📖 Puranic Legend (पौराणिक संदर्भ)
                </h5>
                <div class="space-y-2 text-charcoal-brown/95">
                  <p class="leading-relaxed">
                    {verse.story.en}
                  </p>
                  {verse.story.hi && (
                    <p class="font-hindi-display text-sm leading-relaxed border-t border-brass-gold/10 pt-2 text-charcoal-brown/85">
                      {verse.story.hi}
                    </p>
                  )}
                </div>
              </div>
            )}

          </div>
        );
      })}
    </div>

    <!-- Frequently Asked Questions Section -->
    <section id="faqs" class="scroll-mt-24 space-y-6">
      <div class="text-center space-y-2">
        <span class="text-[10px] uppercase font-bold tracking-widest text-maroon-deep bg-marigold/30 px-2.5 py-0.5 rounded border border-marigold inline-block">
          Common Questions & Doubts • प्रश्नोत्तरी
        </span>
        <h2 class="font-serif-display text-2xl sm:text-3xl uppercase tracking-wider font-bold text-maroon-deep">
          Frequently Asked Questions
        </h2>
        <p class="text-xs sm:text-sm text-charcoal-brown/70 max-w-2xl mx-auto leading-relaxed">
          Comprehensive, authentic answers regarding the authorship, history, meaning, pronunciation, and ritual recitation of the Shree Hanuman Chalisa.
        </p>
      </div>

      <div class="space-y-3">
        {meaningFaqs.map((faq, idx) => (
          <details
            class="bg-stone-ivory border-2 border-brass-gold/30 rounded-lg p-4 sm:p-5 shadow-sm group transition-all duration-200 hover:border-brass-gold"
            open={idx === 0}
          >
            <summary class="font-serif-display font-bold text-maroon-deep text-sm sm:text-base cursor-pointer flex justify-between items-center select-none">
              <span class="flex items-center gap-2">
                <span class="text-xs text-brass-gold font-sans font-semibold">Q{idx + 1}.</span>
                {faq.question}
              </span>
              <span class="text-xs text-brass-gold font-sans font-semibold group-open:rotate-180 transition-transform duration-200 shrink-0 ml-2">
                ▼
              </span>
            </summary>
            <div class="mt-3 pt-3 border-t border-brass-gold/20 text-xs sm:text-sm text-charcoal-brown/90 leading-relaxed font-sans">
              <p set:html={faq.answer} />
            </div>
          </details>
        ))}
      </div>
    </section>

    <CarvedDivider icon="🕉️" />

    <!-- AdSense Footer Slot -->
    <div class="no-print w-full h-24 bg-stone-ivory border border-brass-gold/20 flex items-center justify-center text-xs text-charcoal-brown/40 tracking-widest uppercase rounded shadow-inner my-12">
      Ad Slot — Page Bottom (Layout Stable Skeleton)
    </div>

  </div>
</Layout>

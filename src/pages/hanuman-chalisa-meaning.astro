---
import Layout from "../layouts/Layout.astro";
import CarvedDivider from "../components/CarvedDivider";
import SyncedAudioPlayer from "../components/SyncedAudioPlayer";
import hanumanChalisaData from "../data/scriptures/hanuman-chalisa.json";
import type { ScriptureVerse } from "../types/scripture";

const verses = hanumanChalisaData as ScriptureVerse[];

const title = "Hanuman Chalisa Meaning — Line by Line English & Hindi Translation";
const description = "Study the deep meaning of Hanuman Chalisa. Detailed word-by-word translations, stories, and historical interpretations in Hindi and English.";
---

<Layout title={title} description={description}>
  <div class="space-y-10 max-w-5xl mx-auto">
    
    <!-- Breadcrumbs -->
    <nav class="text-xs text-charcoal-brown/50 font-semibold" aria-label="Breadcrumb">
      <ol class="list-none p-0 inline-flex gap-2">
        <li class="flex items-center">
          <a href="/" class="hover:text-maroon-deep">Home</a>
          <span class="mx-2">/</span>
        </li>
        <li class="text-maroon-deep truncate max-w-[200px]" aria-current="page">
          Meaning
        </li>
      </ol>
    </nav>

    <!-- Page Header -->
    <div class="text-center space-y-3">
      <span class="text-xs font-bold tracking-widest text-maroon-deep bg-marigold/30 px-3 py-1 rounded border border-marigold">
        Detailed Exposition (भावार्थ)
      </span>
      <h1 class="font-serif-display text-3xl uppercase tracking-wider font-bold text-maroon-deep">
        Hanuman Chalisa Verses & Meaning
      </h1>
      <p class="text-xs text-charcoal-brown/70 max-w-2xl mx-auto leading-relaxed">
        Below is the complete line-by-line Sanskrit-Awadhi text of the Hanuman Chalisa. Explore literal translations, deep spiritual interpretations, related Puranic stories, and word-by-word meanings.
      </p>
    </div>

    <CarvedDivider icon="📖" />

    <!-- AdSense Top Slot -->
    <div class="no-print w-full h-24 bg-stone-ivory border border-brass-gold/20 flex items-center justify-center text-xs text-charcoal-brown/40 tracking-widest uppercase rounded shadow-inner">
      Ad Slot — Page Top (Layout Stable Skeleton)
    </div>

    <!-- Table of Contents / Quick Verse Navigator -->
    <nav class="bg-stone-ivory border-2 border-brass-gold/30 rounded-lg p-5 shadow-sm space-y-3" aria-label="Page Table of Contents">
      <h3 class="font-serif-display text-xs font-bold uppercase tracking-widest text-maroon-deep flex items-center gap-2">
        <span>📜</span> Quick Directory & Navigation
      </h3>
      <div class="flex flex-wrap gap-2 text-xs font-semibold">
        <a href="#story" class="bg-marigold/20 hover:bg-marigold text-maroon-deep px-3 py-1.5 rounded border border-brass-gold/30 transition-colors">
          The Story Behind the Chalisa
        </a>
        <a href="#audio-player" class="bg-marigold/20 hover:bg-marigold text-maroon-deep px-3 py-1.5 rounded border border-brass-gold/30 transition-colors flex items-center gap-1">
          <span>🎵</span> Synced Audio
        </a>
        <a href="#doha-01" class="bg-stone-ivory hover:bg-marigold/10 text-charcoal-brown px-3 py-1.5 rounded border border-brass-gold/20 transition-colors">
          Opening Dohas
        </a>
        <a href="#verse-1" class="bg-stone-ivory hover:bg-marigold/10 text-charcoal-brown px-3 py-1.5 rounded border border-brass-gold/20 transition-colors">
          Chaupais 1–10
        </a>
        <a href="#verse-11" class="bg-stone-ivory hover:bg-marigold/10 text-charcoal-brown px-3 py-1.5 rounded border border-brass-gold/20 transition-colors">
          Chaupais 11–20
        </a>
        <a href="#verse-21" class="bg-stone-ivory hover:bg-marigold/10 text-charcoal-brown px-3 py-1.5 rounded border border-brass-gold/20 transition-colors">
          Chaupais 21–30
        </a>
        <a href="#verse-31" class="bg-stone-ivory hover:bg-marigold/10 text-charcoal-brown px-3 py-1.5 rounded border border-brass-gold/20 transition-colors">
          Chaupais 31–40
        </a>
        <a href="#doha-closing" class="bg-stone-ivory hover:bg-marigold/10 text-charcoal-brown px-3 py-1.5 rounded border border-brass-gold/20 transition-colors">
          Concluding Doha
        </a>
      </div>
    </nav>

    <!-- The Story Behind the Hanuman Chalisa Section -->
    <section id="story" class="scroll-mt-24 bg-stone-ivory border-2 border-brass-gold/40 rounded-lg p-6 sm:p-8 shadow-sm space-y-5">
      <div class="space-y-1.5 border-b border-brass-gold/20 pb-3">
        <span class="text-[10px] uppercase font-bold tracking-widest text-maroon-deep bg-marigold/30 px-2.5 py-0.5 rounded border border-marigold">
          Devotional History & Origin • रचना का इतिहास
        </span>
        <h2 class="font-serif-display text-2xl sm:text-3xl uppercase tracking-wider font-bold text-maroon-deep">
          The Story Behind the Hanuman Chalisa
        </h2>
      </div>

      <div class="space-y-4 text-xs sm:text-sm text-charcoal-brown/90 leading-relaxed font-sans">
        <p>
          Who wrote the Hanuman Chalisa, and under what circumstances was this timeless hymn created? Tradition holds that the sacred quatrains were composed during the 16th century by the illustrious Bhakti poet-saint <strong>Goswami Tulsidas</strong> (1532–1623 CE). Revered throughout India as an incarnation of Sage Valmiki, Tulsidas was the master devotee who authored the immortal <em>Ramcharitmanas</em>, transforming the Sanskrit Ramayana into the vernacular language so that common devotees could access its divine wisdom. Composed in <strong>Awadhi</strong>—a literary Eastern Hindi dialect known for its sweet, melodious cadence—the Hanuman Chalisa was specifically crafted with rhythmic meters suited for communal singing, daily memorization, and meditative recitation.
        </p>
        <p>
          According to popular devotional legend, the origin of the Chalisa arose from a historic confrontation in the imperial capital. As Tulsidas's spiritual fame and miracles of devotion spread across northern India, tales of his saintly presence reached the Mughal court of Emperor Akbar in Agra and Fatehpur Sikri. Intrigued by the saint's widespread following, the Emperor summoned Tulsidas to his court and requested that he perform a miracle to substantiate his divine favor. Tulsidas humbly refused, explaining that he possessed no supernatural powers of his own and was merely an ordinary servant of God, noting that all genuine miracles belong exclusively to Lord Rama and Sri Hanuman. Displeased by the poet's refusal to comply with an imperial command, the Emperor ordered Tulsidas imprisoned in chains within the citadel until he produced a miracle.
        </p>
        <p>
          Imprisoned and held in captivity, tradition holds that Tulsidas turned his complete consciousness toward Lord Hanuman—the supreme <em>Sankat Mochan</em> (remover of distress) and guardian of all devotees who take refuge in Rama's lotus feet. Deprived of any worldly recourse, the poet-saint poured his steadfast faith into verse, writing one devotional quatrain (chaupai) each day from within his cell. Over forty consecutive days of solitary meditation and prayer, he composed the forty verses celebrating Hanuman's unmatched valor, wisdom, humility, and selfless service, framing them with opening and concluding couplets (dohas).
        </p>
        <p>
          Devotional history recounts that on the fortieth day, immediately upon Tulsidas's completion and recitation of the final chaupai, an extraordinary phenomenon swept through the imperial citadel of Fatehpur Sikri. A vast legion of thousands of monkeys swarmed the royal capital, overrunning palaces, courtyards, watchtowers, and council chambers, throwing the royal guards into total disarray while harming none of the innocent populace. Recognizing this sudden visitation as unmistakable divine intervention, Emperor Akbar was overcome with remorse, immediately ordered Tulsidas released with imperial honors, and sought the saint's blessing. Popular legend holds that as soon as Tulsidas was freed and bestowed peace upon the realm, the monkey host vanished into the surrounding forests, leaving humanity with the eternal prayer of protection: the <em>Shree Hanuman Chalisa</em>.
        </p>
      </div>
    </section>

    <!-- Interactive Synced Audio Player Section -->
    <section id="audio-player" class="scroll-mt-24 space-y-4">
      <div class="bg-stone-ivory border-2 border-brass-gold/40 rounded-lg p-5 sm:p-6 shadow-sm space-y-2">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-brass-gold/20 pb-3">
          <div>
            <span class="text-[10px] uppercase font-bold tracking-widest text-maroon-deep bg-marigold/30 px-2.5 py-0.5 rounded border border-marigold inline-block">
              Interactive Audio • सस्वर पाठ
            </span>
            <h3 class="font-serif-display text-xl sm:text-2xl font-bold uppercase tracking-wider text-maroon-deep mt-1">
              Listen While You Read (ऑडियो सुनें)
            </h3>
          </div>
          <a
            href="/hanuman-chalisa-audio-mp3"
            class="self-start sm:self-center shrink-0 text-xs font-bold uppercase text-vermilion hover:text-marigold transition-colors flex items-center gap-1 font-semibold"
          >
            <span>🎵</span> Full Audio Studio &rarr;
          </a>
        </div>
        <p class="text-xs sm:text-sm text-charcoal-brown/85 font-medium leading-relaxed">
          Listen to the Hanuman Chalisa while reading the meaning below to help with pronunciation.
        </p>
      </div>

      <SyncedAudioPlayer client:load />
    </section>

    <CarvedDivider icon="🕉️" />

    <!-- Verses Meaning List -->
    <div class="space-y-12">
      {verses.map((verse) => {
        const isDoha = verse.id.startsWith("doha-");
        const verseNumberLabel = isDoha
          ? verse.id === "doha-01"
            ? "Introductory Doha 1"
            : verse.id === "doha-02"
            ? "Introductory Doha 2"
            : "Concluding Doha"
          : `Chaupai ${verse.verse_number}`;

        const anchorId = isDoha ? verse.id : `verse-${verse.verse_number}`;

        return (
          <div
            id={anchorId}
            class="scroll-mt-20 p-6 sm:p-8 bg-stone-ivory border border-brass-gold/30 rounded-lg shadow-sm space-y-6 hover:shadow-md transition-shadow duration-200"
          >
            {/* Verse Label */}
            <div class="flex justify-between items-center border-b border-brass-gold/20 pb-3">
              <span class="text-xs font-bold tracking-wider text-brass-gold uppercase">
                {verseNumberLabel}
              </span>
              <span class="text-[10px] text-charcoal-brown/50">
                {isDoha ? "Couplet Meter" : "Quatrain Meter"}
              </span>
            </div>

            {/* Devanagari Script */}
            <div class="space-y-2">
              <p class="font-hindi-display text-2xl sm:text-3xl text-charcoal-brown leading-loose text-center font-bold tracking-wide">
                {verse.devanagari}
              </p>
              {/* Transliteration */}
              <p class="text-xs sm:text-sm text-center text-charcoal-brown/70 italic max-w-xl mx-auto">
                {verse.transliteration}
              </p>
            </div>

            {/* Translation Panels */}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-brass-gold/20">
              
              {/* English Meanings */}
              <div class="space-y-3 bg-stone-ivory/30 p-4 border border-brass-gold/10 rounded">
                <h4 class="font-serif-display text-xs font-bold uppercase tracking-wider text-maroon-deep border-b border-brass-gold/10 pb-1 flex items-center gap-1">
                  🇺🇸 English Meaning
                </h4>
                <div class="space-y-2 text-xs sm:text-sm">
                  <p class="font-semibold text-charcoal-brown">
                    <span class="text-brass-gold text-[10px] uppercase font-bold mr-1 block sm:inline">Literal:</span>
                    {verse.literal_translation.en}
                  </p>
                  <p class="text-charcoal-brown/80 leading-relaxed">
                    <span class="text-brass-gold text-[10px] uppercase font-bold mr-1 block">Exposition:</span>
                    {verse.interpretive_meaning.en}
                  </p>
                </div>
              </div>

              {/* Hindi Meanings */}
              <div class="space-y-3 bg-stone-ivory/30 p-4 border border-brass-gold/10 rounded">
                <h4 class="font-serif-display text-xs font-bold uppercase tracking-wider text-maroon-deep border-b border-brass-gold/10 pb-1 flex items-center gap-1">
                  🇮🇳 हिंदी अर्थ
                </h4>
                <div class="space-y-2 text-xs sm:text-sm">
                  <p class="font-semibold text-charcoal-brown font-hindi-display text-base">
                    <span class="text-brass-gold text-[10px] uppercase font-bold mr-1 font-sans block sm:inline">शब्दार्थ:</span>
                    {verse.literal_translation.hi}
                  </p>
                  <p class="text-charcoal-brown/80 leading-relaxed font-hindi-display text-base">
                    <span class="text-brass-gold text-[10px] uppercase font-bold mr-1 font-sans block">भावार्थ:</span>
                    {verse.interpretive_meaning.hi}
                  </p>
                </div>
              </div>

            </div>

            {/* Word by Word Dictionary */}
            {verse.word_meanings && verse.word_meanings.length > 0 && (
              <details class="group border border-brass-gold/20 rounded bg-stone-ivory/40">
                <summary class="cursor-pointer select-none px-4 py-2.5 font-serif-display text-xs font-bold tracking-widest text-maroon-deep hover:bg-marigold/10 transition-colors uppercase flex justify-between items-center">
                  <span>📚 Word-by-Word Dictionary (शब्दार्थ विश्लेषण)</span>
                  <span class="text-xs group-open:rotate-180 transition-transform duration-200">
                    ▼
                  </span>
                </summary>
                <div class="p-4 border-t border-brass-gold/10 overflow-x-auto">
                  <table class="w-full text-xs text-left border-collapse">
                    <thead>
                      <tr class="border-b border-brass-gold/20 text-brass-gold uppercase tracking-wider">
                        <th class="py-2 font-bold">Word (मूल शब्द)</th>
                        <th class="py-2 font-bold">IAST</th>
                        <th class="py-2 font-bold">Hindi Meaning</th>
                        <th class="py-2 font-bold">English Meaning</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-brass-gold/10 text-charcoal-brown">
                      {verse.word_meanings.map((wm) => (
                        <tr class="hover:bg-marigold/5 transition-colors">
                          <td class="py-2.5 font-bold font-hindi-display text-sm">{wm.word}</td>
                          <td class="py-2.5 italic">{wm.roman}</td>
                          <td class="py-2.5 font-hindi-display text-sm">{wm.meaning.hi}</td>
                          <td class="py-2.5">{wm.meaning.en}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </details>
            )}

            {/* Story / Puranic Legend Section */}
            {verse.story && verse.story.en && (
              <div class="bg-marigold/5 border-l-4 border-marigold p-4 rounded-r text-xs sm:text-sm">
                <h5 class="font-serif-display font-bold uppercase tracking-wider text-maroon-deep mb-1.5 flex items-center gap-1">
                  📖 Puranic Legend (पौराणिक संदर्भ)
                </h5>
                <div class="space-y-2 text-charcoal-brown/95">
                  <p class="leading-relaxed">
                    {verse.story.en}
                  </p>
                  {verse.story.hi && (
                    <p class="font-hindi-display text-sm leading-relaxed border-t border-brass-gold/10 pt-2 text-charcoal-brown/85">
                      {verse.story.hi}
                    </p>
                  )}
                </div>
              </div>
            )}

          </div>
        );
      })}
    </div>

    <!-- AdSense Footer Slot -->
    <div class="no-print w-full h-24 bg-stone-ivory border border-brass-gold/20 flex items-center justify-center text-xs text-charcoal-brown/40 tracking-widest uppercase rounded shadow-inner my-12">
      Ad Slot — Page Bottom (Layout Stable Skeleton)
    </div>

  </div>
</Layout>

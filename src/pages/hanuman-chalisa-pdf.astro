---
import Layout from "../layouts/Layout.astro";
import CarvedDivider from "../components/CarvedDivider";
import PageFaqs from "../components/PageFaqs.astro";
import ShareCardGenerator from "../components/ShareCardGenerator";
import hanumanChalisaData from "../data/scriptures/hanuman-chalisa.json";
import type { ScriptureVerse } from "../types/scripture";
import PrintButton from "../components/PrintButton";

const verses = hanumanChalisaData as ScriptureVerse[];

const openingDohas = verses.filter((v) => v.id.startsWith("doha-"));
const chaupais = verses.filter((v) => v.id.startsWith("chaupai-"));
const dohaClosing = openingDohas.find((v) => v.id === "doha-closing");

const title = "Download & Save Hanuman Chalisa PDF — Print Verses, Dohas & Shlokas";
const description = "Download and save the complete Hanuman Chalisa PDF, print prayer sheets, or save and share individual verses, dohas, chaupais, and aarti.";
---

<Layout title={title} description={description}>
  <div class="space-y-12">
    
    <!-- 1. Public Facing Section (no-print) -->
    <section class="no-print space-y-8 max-w-4xl mx-auto">
      <!-- Breadcrumbs -->
      <nav class="text-xs text-charcoal-brown/50 font-semibold" aria-label="Breadcrumb">
        <ol class="list-none p-0 inline-flex gap-2">
          <li class="flex items-center">
            <a href="/" class="hover:text-maroon-deep">Home</a>
            <span class="mx-2">/</span>
          </li>
          <li class="text-maroon-deep truncate max-w-[200px]" aria-current="page">
            Download & Save Prayers
          </li>
        </ol>
      </nav>

      <div class="text-center space-y-3">
        <span class="text-xs font-bold tracking-widest text-maroon-deep bg-marigold/30 px-3 py-1 rounded border border-marigold">
          Download & Share (डाउनलोड एवं संग्रह)
        </span>
        <h1 class="font-serif-display text-3xl uppercase tracking-wider font-bold text-maroon-deep">
          Download & Save Prayers (PDF, Verses & Cards)
        </h1>
        <p class="text-xs text-charcoal-brown/70 max-w-xl mx-auto leading-relaxed">
          Download a clean print-ready PDF for daily chanting, or save your favorite verses, dohas, chaupais, and aarti as beautiful status cards for WhatsApp and social media.
        </p>
      </div>

      <CarvedDivider icon="📄" />

      <!-- Print Action Box -->
      <div class="bg-maroon-deep text-stone-ivory border-2 border-brass-gold p-6 rounded-lg shadow-md flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2">
          <h3 class="font-serif-display text-lg text-marigold uppercase tracking-wider font-bold">
            Download Print-Ready PDF
          </h3>
          <p class="text-xs text-stone-ivory/80 max-w-lg leading-relaxed">
            We do not use cheap scans or blurry images. Clicking the button compiles the vector characters directly using Google Fonts into a beautiful physical double-column layout. Adjust paper to &ldquo;Save to PDF&rdquo; or print.
          </p>
        </div>
        
        <PrintButton client:load />
      </div>

      <CarvedDivider icon="🕉️" />

      <!-- WhatsApp Status card generator -->
      <ShareCardGenerator client:load />

      <!-- Reusable Dynamic Page FAQs -->
      <PageFaqs
        pageSlug="pdf"
        altSlugs={["hanuman-chalisa-pdf"]}
        title="PDF & Printing FAQs"
      />
    </section>

    <!-- 2. Print-Layout (Only visible during printing or print-previews, styled in globals.css) -->
    <section class="print-only hidden p-10 max-w-3xl mx-auto border-8 double border-black bg-white text-black space-y-6">
      
      <!-- Print Header -->
      <div class="text-center border-b-2 border-black pb-4">
        <h1 class="font-serif-display text-2xl font-bold uppercase tracking-wider">
          SHREE HANUMAN CHALISA
        </h1>
        <p class="text-xs uppercase tracking-widest font-semibold mt-1">
          जय श्री राम • जय हनुमान
        </p>
        <p class="text-[10px] italic mt-0.5">
          Compiled statically for daily chanting - RamHanumanChalisa.com
        </p>
      </div>

      <!-- Opening Dohas -->
      <div class="p-4 border border-black/40 rounded text-center space-y-4">
        <h2 class="text-xs uppercase font-bold tracking-widest border-b border-black/20 pb-1 max-w-[200px] mx-auto">
          Opening Couplets (दोहा)
        </h2>
        {openingDohas.filter(v => v.id !== "doha-closing").map((doha) => (
          <div class="space-y-1">
            <p class="font-hindi-display text-base font-bold leading-loose">
              {doha.devanagari}
            </p>
            <p class="text-[9px] italic max-w-lg mx-auto">
              {doha.transliteration}
            </p>
          </div>
        ))}
      </div>

      <!-- Double Column print layout for the 40 Chaupais -->
      <div class="print-two-columns text-xs space-y-4 pt-4 border-t border-black/20">
        {chaupais.map((verse) => (
          <div class="break-inside-avoid border-b border-black/10 pb-3 mb-3">
            <div class="font-bold text-[9px] uppercase tracking-wider mb-1">
              Verse {verse.verse_number}
            </div>
            <p class="font-hindi-display text-sm font-bold leading-normal mb-1">
              {verse.devanagari}
            </p>
            <p class="text-[8px] italic text-black/60 mb-1.5">
              {verse.transliteration}
            </p>
            <p class="text-[9px] leading-relaxed font-semibold text-black/90">
              {verse.literal_translation.en}
            </p>
          </div>
        ))}
      </div>

      <!-- Concluding Doha -->
      {dohaClosing && (
        <div class="p-4 border border-black/40 rounded text-center space-y-2 mt-6">
          <h2 class="text-xs uppercase font-bold tracking-widest border-b border-black/20 pb-1 max-w-[200px] mx-auto">
            Concluding Couplet (दोहा)
          </h2>
          <p class="font-hindi-display text-base font-bold leading-loose">
            {dohaClosing.devanagari}
          </p>
          <p class="text-[9px] italic mb-1">
            {dohaClosing.transliteration}
          </p>
          <p class="text-[9px] leading-relaxed font-semibold">
            {dohaClosing.literal_translation.en}
          </p>
        </div>
      )}

    </section>

  </div>
</Layout>

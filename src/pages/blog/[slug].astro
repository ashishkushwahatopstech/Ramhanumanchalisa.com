---
import Layout from "../../layouts/Layout.astro";
import { getPrisma } from "../../lib/prisma";
import CarvedDivider from "../../components/CarvedDivider";
import { FALLBACK_BLOG_POSTS, type BlogPost } from "../../data/blog";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const db = Astro.locals.runtime?.env?.DB;
const prisma = getPrisma(db);

interface EnrichedPost extends BlogPost {
  metaTitle?: string | null;
  metaDescription?: string | null;
  coverImage?: string | null;
  imageAlt?: string | null;
  imageTitle?: string | null;
  imageCaption?: string | null;
  focusKeywords?: string | null;
  internalLinks?: string | null;
  sources?: string | null;
  faqs?: string | null;
}

import { getCachedPost } from "../../lib/dynamicContent";
import { d1GetPostBySlug } from "../../lib/d1";

let post: EnrichedPost | undefined;

// 1. Native Cloudflare D1 query
if (db && typeof db.prepare === "function") {
  try {
    const d1Post = await d1GetPostBySlug(db, slug);
    if (d1Post && d1Post.published) {
      post = {
        slug: d1Post.slug,
        title: d1Post.title,
        metaTitle: d1Post.metaTitle,
        metaDescription: d1Post.metaDescription,
        excerpt: d1Post.excerpt,
        content: d1Post.content,
        coverImage: d1Post.coverImage,
        imageAlt: d1Post.imageAlt,
        imageTitle: d1Post.imageTitle,
        imageCaption: d1Post.imageCaption,
        focusKeywords: d1Post.focusKeywords,
        internalLinks: d1Post.internalLinks,
        sources: d1Post.sources,
        faqs: d1Post.faqs,
        createdAt: (() => {
          try {
            return new Date(d1Post.createdAt).toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            });
          } catch {
            return "Recently";
          }
        })(),
        author: "Admin",
        readTime: "5 min read",
      };
    }
  } catch (e) {
    console.warn("Notice: D1 getPostBySlug fallback in blog/[slug]:", e);
  }
}

// 2. Prisma fallback
if (!post && prisma) {
  try {
    const dbPost = await prisma.post.findUnique({ where: { slug } });
    if (dbPost && dbPost.published) {
      post = {
        slug: dbPost.slug,
        title: dbPost.title,
        metaTitle: dbPost.metaTitle,
        metaDescription: dbPost.metaDescription,
        excerpt: dbPost.excerpt,
        content: dbPost.content,
        coverImage: dbPost.coverImage,
        imageAlt: dbPost.imageAlt,
        imageTitle: dbPost.imageTitle,
        imageCaption: dbPost.imageCaption,
        focusKeywords: dbPost.focusKeywords,
        internalLinks: dbPost.internalLinks,
        sources: dbPost.sources,
        faqs: dbPost.faqs,
        createdAt: (() => {
          try {
            return new Date(dbPost.createdAt).toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            });
          } catch {
            return "Recently";
          }
        })(),
        author: "Admin",
        readTime: "5 min read",
      };
    }
  } catch (e) {
    console.warn("Notice: DB post query fallback:", e);
  }
}

// Check runtime cache if DB didn't return post
if (!post) {
  const cached = getCachedPost(slug);
  if (cached && cached.published) {
    post = {
      ...cached,
      createdAt: (() => {
        try {
          return new Date(cached.createdAt).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          });
        } catch {
          return "Recently";
        }
      })(),
      author: cached.author || "Admin",
      readTime: cached.readTime || "5 min read",
    };
  }
}

if (!post) {
  post = FALLBACK_BLOG_POSTS.find((p) => p.slug === slug);
}

if (!post) {
  return Astro.redirect("/404");
}

// Helper to detect if a text chunk is a section heading
function isHeadingCandidate(text: string) {
  const clean = text.replace(/<[^>]+>/g, "").replace(/^[||\s*#]+|[||\s*#]+$/g, "").trim();
  if (!clean || clean.length > 90 || clean.includes("\n") || clean.includes("<br")) return false;

  if (/^Lyrics of /i.test(clean)) return true;
  if (/^Lyrics in /i.test(clean)) return true;
  if (/^Meaning in /i.test(clean)) return true;
  if (/(?:in English|in Hindi|Hindi Lyrics|English Lyrics|Lyrics with Meaning|Lyrics, Meaning|English Text|Hindi Text|Lyrics)$/i.test(clean)) return true;
  if (/^(?:Doha|Dohaa|Chaupai|Chaupaai|Aarti|Stotra|Stuti|Kavach|Ashtak|Chalisa|Sortha|Choupayi)$/i.test(clean)) return true;
  if (/^[॥।।].*[॥।।]$/.test(clean) && clean.length < 50) return true;
  if (/^[A-Z\s]{4,30}$/.test(clean) && !clean.includes(".") && !clean.includes(",") && !clean.includes("|")) return true;

  return false;
}

// Simple parser for standard markdown elements
function parseMarkdown(content: string) {
  const sections = content.split("\n\n").map((section) => section.trim()).filter(Boolean);

  return sections.map((sec) => {
    if (sec.startsWith("### ")) {
      return {
        type: "h4",
        text: sec.replace("### ", ""),
      };
    }
    if (sec.startsWith("## ")) {
      return {
        type: "h3",
        text: sec.replace("## ", ""),
      };
    }
    if (sec.startsWith("*") && sec.endsWith("*")) {
      return {
        type: "italic",
        text: sec.replace(/\*/g, ""),
      };
    }
    if (sec.startsWith("- ")) {
      const items = sec.split("\n").map((item) => item.replace("- ", "").trim());
      return {
        type: "list",
        items,
      };
    }
    if (sec.startsWith("<") && (sec.includes(">") || sec.endsWith(">"))) {
      return {
        type: "html",
        text: sec,
      };
    }
    if (sec.startsWith("![") && sec.includes("](") && sec.endsWith(")")) {
      const match = sec.match(/^!\[(.*?)\]\((.*?)\)$/);
      if (match) {
        return {
          type: "html",
          text: `<figure class="my-6 text-center"><img src="${match[2]}" alt="${match[1]}" class="rounded-lg shadow-md mx-auto max-w-full h-auto" loading="lazy" /></figure>`,
        };
      }
    }
    // Check if plain text chunk is an unformatted heading (e.g. "Lyrics of Deva ho Deva in English")
    if (isHeadingCandidate(sec)) {
      const cleanHeading = sec.replace(/<[^>]+>/g, "").replace(/^[||\s*]+|[||\s*]+$/g, "").trim();
      const isMajor = /^Lyrics of |^Lyrics in |Hindi Lyrics|English Lyrics|Lyrics$/i.test(cleanHeading);
      return {
        type: isMajor ? "h2" : "h3",
        text: cleanHeading,
      };
    }
    return {
      type: "p",
      text: sec,
    };
  });
}

const parsedContent = parseMarkdown(post.content);

let isoDate = "";
try {
  isoDate = new Date(post.createdAt).toISOString();
} catch {
  isoDate = new Date().toISOString();
}

// Parse FAQs and Internal Links if available
let faqList: Array<{ question: string; answer: string }> = [];
try {
  if (post.faqs) {
    faqList = JSON.parse(post.faqs);
  }
} catch {
  faqList = [];
}

// If no custom FAQs exist (e.g. imported posts), automatically generate rich, context-specific FAQ schema
if (faqList.length === 0) {
  const isChalisa = post.title.toLowerCase().includes("chalisa");
  const isAarti = post.title.toLowerCase().includes("aarti");
  const isStotra = post.title.toLowerCase().includes("stotra") || post.title.toLowerCase().includes("stuti") || post.title.toLowerCase().includes("ashtak");
  
  const entityName = post.title
    .replace(/(?:Lyrics|in Hindi|in English|PDF|Meaning|Song|Text|with Meaning|,)+/gi, "")
    .trim();

  if (isChalisa) {
    faqList = [
      {
        question: `What is the spiritual significance of reciting ${entityName}?`,
        answer: `Reciting ${entityName} with pure devotion helps invoke divine grace, remove spiritual afflictions, and bring inner peace, mental clarity, and protection to the devotee's household.`
      },
      {
        question: `When is the best time to recite ${entityName}?`,
        answer: `The most auspicious time is during Brahma Muhurat (early morning between 4:00 AM and 6:00 AM) or during evening Sandhya prayers, ideally after taking a bath and lighting a ghee diya.`
      },
      {
        question: `How many times should ${entityName} be recited?`,
        answer: `It can be recited 1, 3, 7, or 11 times daily. On auspicious days or during special vows (sankalpa), devotees often chant it 21 or 108 times.`
      }
    ];
  } else if (isAarti) {
    faqList = [
      {
        question: `What is the significance of singing ${entityName}?`,
        answer: `Singing ${entityName} concludes the puja ceremony by illuminating the divine deity with lighted wicks or camphor, expressing deep gratitude and seeking divine protection.`
      },
      {
        question: `What rituals should accompany ${entityName}?`,
        answer: `Stand with folded hands or hold the aarti plate with both hands, gently revolving it in a clockwise circular motion before the deity while ringing a bell or clapping in devotion.`
      }
    ];
  } else {
    faqList = [
      {
        question: `What are the spiritual benefits of chanting ${post.title}?`,
        answer: `Chanting ${post.title} clears negative energies, enhances concentration, and aligns the devotee's mind with peaceful and uplifting vibrations.`
      },
      {
        question: `Are lyrics provided in both Hindi and English?`,
        answer: `Yes, this authentic guide provides complete lyrics in original Devanagari Hindi as well as easy-to-read English transliteration and devotional meaning.`
      }
    ];
  }
}

let internalLinkList: Array<{ label: string; url: string }> = [];
try {
  if (post.internalLinks) {
    internalLinkList = JSON.parse(post.internalLinks);
  }
} catch {
  internalLinkList = [];
}

// Fallback internal links to maintain strong SEO graph
if (internalLinkList.length === 0) {
  internalLinkList = [
    { label: "Shree Hanuman Chalisa (हिंदी व English)", url: "/" },
    { label: "Sankat Mochan Hanumanashtak", url: "/sankat-mochan-hanumanashtak" },
    { label: "Shri Ram Chalisa", url: "/ram-chalisa" },
    { label: "Hanuman Aarti", url: "/hanuman-aarti" },
    { label: "Path Vidhi & Recitation Rules", url: "/shri-hanuman-chalisa-path-vidhi" }
  ];
}

const cleanTitle = post.title.replace(/\s+/g, " ").trim();
const pageTitle = post.metaTitle || `${cleanTitle} — Lyrics, Meaning & PDF`;
const pageDescription = post.metaDescription || (
  post.excerpt.length > 50 
    ? `${post.excerpt.slice(0, 155).trim()}... Read full lyrics in Hindi & English with spiritual meaning.`
    : `Read authentic ${cleanTitle} with complete Hindi lyrics, English transliteration, word-by-word spiritual meaning, and recitation guidelines on RamHanumanChalisa.com.`
);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": cleanTitle,
  "description": pageDescription,
  "datePublished": isoDate,
  "dateModified": isoDate,
  "inLanguage": "en-US",
  "image": post.coverImage
    ? [post.coverImage.startsWith("http") ? post.coverImage : `https://ramhanumanchalisa.com${post.coverImage.startsWith("/") ? "" : "/"}${post.coverImage}`]
    : ["https://ramhanumanchalisa.com/og-image.jpg"],
  "author": {
    "@type": "Person",
    "name": post.author || "Acharya Ramesh Dwivedi",
    "jobTitle": "Vedic Scholar & Devotional Editor",
    "url": "https://ramhanumanchalisa.com/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Ram Hanuman Chalisa",
    "url": "https://ramhanumanchalisa.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://ramhanumanchalisa.com/icon.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://ramhanumanchalisa.com/blog/${post.slug}`
  }
};

// Search Console Compliant FAQPage Schema
const faqSchema =
  faqList.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqList.map((f) => ({
          "@type": "Question",
          "name": f.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": f.answer,
          },
        })),
      }
    : null;
---

<Layout title={pageTitle} description={pageDescription} canonicalUrl={`https://ramhanumanchalisa.com/blog/${post.slug}`}>
  <!-- Blog Article Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  
  <!-- Search Console FAQ Schema -->
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}

  <div class="space-y-8 max-w-3xl mx-auto">
    <!-- Breadcrumbs -->
    <nav class="text-xs text-charcoal-brown/50 font-semibold" aria-label="Breadcrumb">
      <ol class="list-none p-0 inline-flex gap-2">
        <li class="flex items-center">
          <a href="/" class="hover:text-maroon-deep">Home</a>
          <span class="mx-2">/</span>
        </li>
        <li class="flex items-center">
          <a href="/blog" class="hover:text-maroon-deep">Blog</a>
          <span class="mx-2">/</span>
        </li>
        <li class="text-maroon-deep truncate max-w-[200px]" aria-current="page">
          {post.title}
        </li>
      </ol>
    </nav>

    <!-- Post Header -->
    <div class="space-y-4 text-center sm:text-left">
      <h1 class="font-serif-display text-2xl sm:text-3xl font-bold text-maroon-deep uppercase leading-tight">
        {post.title}
      </h1>

      <div class="flex flex-wrap justify-center sm:justify-start items-center gap-3 text-xs text-brass-gold font-bold">
        <span>{post.createdAt}</span>
        <span>•</span>
        <span>By {post.author}</span>
        <span>•</span>
        <span>{post.readTime}</span>
        {post.focusKeywords && (
          <>
            <span>•</span>
            <span class="text-charcoal-brown/60">Tags: {post.focusKeywords}</span>
          </>
        )}
      </div>
    </div>

    <CarvedDivider icon="🕉️" />

    <!-- Cover Image with SEO tags -->
    {post.coverImage && (
      <figure class="my-6 rounded-lg overflow-hidden border border-brass-gold/30 bg-stone-ivory shadow-md">
        <img
          src={post.coverImage}
          alt={post.imageAlt || post.title}
          title={post.imageTitle || post.title}
          class="w-full max-h-[460px] object-cover"
          loading="lazy"
        />
        {post.imageCaption && (
          <figcaption class="p-3 text-center text-xs text-charcoal-brown/70 italic border-t border-brass-gold/20 bg-stone-ivory/50">
            {post.imageCaption}
          </figcaption>
        )}
      </figure>
    )}

    <!-- Ad Slot -->
    <div class="no-print w-full h-24 bg-stone-ivory border border-brass-gold/20 flex items-center justify-center text-xs text-charcoal-brown/40 tracking-widest uppercase rounded shadow-inner my-6">
      Ad Slot — Article Top (Layout Stable)
    </div>

    <!-- Main Post Content -->
    <article class="blog-article-content bg-stone-ivory border border-brass-gold/30 p-6 sm:p-8 rounded-lg shadow-sm space-y-4">
      {parsedContent.map((item) => {
        if (item.type === "h2") {
          return <h2 class="font-serif-display text-xl sm:text-2xl font-bold text-maroon-deep mt-8 mb-3 pb-2 border-b border-brass-gold/20">{item.text}</h2>;
        }
        if (item.type === "h4") {
          return <h4 class="font-serif-display text-lg font-bold text-maroon-deep mt-6 mb-2">{item.text}</h4>;
        }
        if (item.type === "h3") {
          return <h3 class="font-serif-display text-xl font-bold text-maroon-deep mt-8 mb-3">{item.text}</h3>;
        }
        if (item.type === "italic") {
          return <p class="text-xs sm:text-sm text-charcoal-brown/70 italic my-3 text-center">{item.text}</p>;
        }
        if (item.type === "list") {
          return (
            <ul class="list-disc list-inside space-y-2 text-xs sm:text-sm text-charcoal-brown/85 my-4 pl-4">
              {item.items?.map((li) => (
                <li>{li}</li>
              ))}
            </ul>
          );
        }
        if (item.type === "html") {
          return <div set:html={item.text} />;
        }
        return <p class="text-xs sm:text-sm text-charcoal-brown/95 leading-relaxed my-3" set:html={item.text} />;
      })}
    </article>

    <!-- Interactive Search Console FAQ Section -->
    {faqList.length > 0 && (
      <section class="bg-stone-ivory border border-brass-gold/40 rounded-xl p-6 shadow-sm space-y-4">
        <div class="flex items-center gap-2 border-b border-brass-gold/20 pb-3">
          <span class="text-xl">❓</span>
          <h2 class="font-serif-display text-lg sm:text-xl font-bold text-maroon-deep uppercase">
            Frequently Asked Questions
          </h2>
        </div>
        <div class="space-y-3">
          {faqList.map((faq) => (
            <details class="group bg-white rounded-lg border border-brass-gold/30 p-4 transition-all open:shadow-sm">
              <summary class="font-bold text-sm text-maroon-deep cursor-pointer list-none flex justify-between items-center select-none">
                <span>{faq.question}</span>
                <span class="text-brass-gold transition-transform group-open:rotate-180">▼</span>
              </summary>
              <div class="mt-3 pt-3 border-t border-brass-gold/20 text-xs sm:text-sm text-charcoal-brown/85 leading-relaxed">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Internal Links / Recommended Readings -->
    {internalLinkList.length > 0 && (
      <section class="p-5 bg-brass-gold/10 border border-brass-gold/30 rounded-xl space-y-3">
        <h3 class="text-xs uppercase font-bold text-maroon-deep tracking-wider flex items-center gap-1.5">
          <span>🔗</span> Recommended Devotional Links
        </h3>
        <div class="flex flex-wrap gap-2">
          {internalLinkList.map((link) => (
            <a
              href={link.url}
              class="inline-flex items-center gap-1 px-3 py-1.5 bg-white border border-brass-gold/40 rounded-full text-xs font-bold text-maroon-deep hover:bg-marigold transition-colors shadow-sm"
            >
              <span>🕉️</span> {link.label}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Author E-E-A-T Profile Card -->
    <div class="p-5 bg-white border border-brass-gold/35 rounded-xl shadow-sm flex flex-col sm:flex-row items-center sm:items-start gap-4">
      <div class="w-16 h-16 rounded-full bg-maroon-deep text-marigold flex items-center justify-center font-serif-display text-2xl font-bold shrink-0 shadow-inner border-2 border-brass-gold/40">
        🕉️
      </div>
      <div class="space-y-1.5 text-center sm:text-left flex-1">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
          <h3 class="font-serif-display font-bold text-base text-maroon-deep">
            {post.author || "Acharya Ramesh Dwivedi"}
          </h3>
          <span class="text-[11px] font-semibold text-brass-gold bg-marigold/15 px-2.5 py-0.5 rounded-full self-center sm:self-auto">
            Vedic Scholar & Devotional Editor
          </span>
        </div>
        <p class="text-xs text-charcoal-brown/80 leading-relaxed">
          Devoted researcher in Vedic stotras, Awadhi classical poetry, and Sanatana Dharma literature. All hymns, meanings, and recitation guidelines are rigorously authenticated against traditional Gita Press editions.
        </p>
        <div class="pt-1 text-[11px] text-charcoal-brown/50 flex items-center justify-center sm:justify-start gap-3">
          <span>Reviewed for spiritual & phonetic accuracy</span>
          <span>•</span>
          <a href="/about" class="text-vermilion hover:underline">Editorial Guidelines &rarr;</a>
        </div>
      </div>
    </div>

    <!-- Scriptural Citations & Sources -->
    {post.sources && (
      <footer class="p-4 bg-stone-ivory border-l-4 border-brass-gold rounded text-xs text-charcoal-brown/70 space-y-1">
        <p class="font-bold uppercase tracking-wider text-maroon-deep text-[11px]">
          📜 Scriptural Citations & Authentic Sources:
        </p>
        <p class="leading-relaxed">{post.sources}</p>
      </footer>
    )}

    <div class="text-center pt-4">
      <a
        href="/blog"
        class="text-xs uppercase font-bold text-maroon-deep hover:text-marigold transition-colors border-b-2 border-maroon-deep/30 hover:border-marigold"
      >
        &larr; Back to all articles
      </a>
    </div>

    <!-- Ad Slot -->
    <div class="no-print w-full h-24 bg-stone-ivory border border-brass-gold/20 flex items-center justify-center text-xs text-charcoal-brown/40 tracking-widest uppercase rounded shadow-inner my-12">
      Ad Slot — Article Bottom (Layout Stable)
    </div>
  </div>
</Layout>

<style is:global>
  .blog-article-content h2 {
    font-family: var(--font-serif, serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: #5c1d11;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .blog-article-content h3 {
    font-family: var(--font-serif, serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #5c1d11;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  .blog-article-content img {
    border-radius: 0.5rem;
    max-width: 100%;
    height: auto;
    margin: 1.25rem auto;
    display: block;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
  }
  .blog-article-content a {
    color: #b33927;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s;
  }
  .blog-article-content a:hover {
    color: #e5a93b;
  }
  .blog-article-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.875rem;
  }
  .blog-article-content th,
  .blog-article-content td {
    border: 1px solid rgba(197, 160, 89, 0.3);
    padding: 0.5rem 0.75rem;
  }
  .blog-article-content th {
    background-color: rgba(197, 160, 89, 0.15);
    color: #5c1d11;
    font-weight: 700;
  }
  .blog-article-content blockquote {
    border-left: 3px solid #c5a059;
    padding-left: 1rem;
    margin: 1rem 0;
    font-style: italic;
    color: rgba(44, 30, 24, 0.85);
  }
</style>

---
import Layout from "../../layouts/Layout.astro";
import { getPrisma } from "../../lib/prisma";
import CarvedDivider from "../../components/CarvedDivider";
import { FALLBACK_BLOG_POSTS, type BlogPost } from "../../data/blog";
import { d1GetBlogConfig } from "../../lib/d1";
import { getBlogConfig, type BlogLayoutConfig } from "../../lib/dynamicContent";

const db = Astro.locals.runtime?.env?.DB;
const prisma = getPrisma(db);

// Load Blog Layout & Sidebar Configuration
let blogConfig: BlogLayoutConfig | null = null;
if (db && typeof db.prepare === "function") {
  try {
    blogConfig = await d1GetBlogConfig(db);
  } catch (e) {
    console.warn("Notice: D1 getBlogConfig in blog/index.astro:", e);
  }
}
if (!blogConfig) {
  blogConfig = getBlogConfig();
}

let posts: BlogPost[] = [];

try {
  const dbPosts = await prisma.post.findMany({
    where: { published: true },
    orderBy: { createdAt: "desc" },
  });

  if (dbPosts.length > 0) {
    posts = dbPosts.map((p) => {
      const imgMatch = p.content?.match(/<img[^>]+src=["']([^"']+)["']/i);
      return {
        slug: p.slug,
        title: p.title,
        excerpt: p.excerpt,
        content: p.content,
        coverImage: p.coverImage || undefined,
        featuredImage: p.coverImage || imgMatch?.[1] || undefined,
        createdAt: p.createdAt.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        }),
        author: "Admin",
        readTime: "5 min read",
      };
    });
  } else {
    posts = FALLBACK_BLOG_POSTS;
  }
} catch (error) {
  console.error("Failed to query DB posts, falling back to static posts:", error);
  posts = FALLBACK_BLOG_POSTS;
}

// Guarantee chronologically newest posts at the top
posts.sort((a, b) => {
  const timeA = new Date(a.createdAt).getTime() || 0;
  const timeB = new Date(b.createdAt).getTime() || 0;
  return timeB - timeA;
});

const recentPosts = posts.slice(0, 5);

const title = "Bhakti Blog & Scripture Library — Chalisas, Aartis & Stotras";
const description = "Explore our Bhakti blog and devotional library with complete lyrics, word-by-word meanings, PDFs, and scholarly guides for Chalisas, Aartis, and Stotras.";

// Collect unique categories
const allCategories = [
  "All",
  "Hanuman Ji",
  "Shri Ram",
  "Lord Shiva",
  "Lord Ganesh",
  "Lord Krishna",
  "Maa Durga & Devis",
  "Devtas & Saints",
  "Devotional Prayers"
];

// Query parameter support if provided
const searchParams = Astro.url.searchParams;
const currentCategory = searchParams.get("category") || "All";
const searchQuery = (searchParams.get("q") || "").toLowerCase().trim();
const page = Math.max(1, parseInt(searchParams.get("page") || "1", 10));
const pageSize = blogConfig?.postsPerPage && Number(blogConfig.postsPerPage) > 0 ? Number(blogConfig.postsPerPage) : 15;

let filteredPosts = posts.filter((p) => {
  const matchesCat = currentCategory === "All" || p.category === currentCategory;
  const matchesSearch = !searchQuery || 
    p.title.toLowerCase().includes(searchQuery) || 
    p.excerpt.toLowerCase().includes(searchQuery);
  return matchesCat && matchesSearch;
});

const totalPages = Math.ceil(filteredPosts.length / pageSize) || 1;
const paginatedPosts = filteredPosts.slice((page - 1) * pageSize, page * pageSize);
const isSidebarActive = blogConfig?.sidebarEnabled ?? true;
---

<Layout title={title} description={description}>
  <div class={`space-y-8 mx-auto ${isSidebarActive ? "max-w-7xl px-3 sm:px-4" : "max-w-4xl"}`}>
    
    <!-- Breadcrumbs -->
    <nav class="text-xs text-charcoal-brown/50 font-semibold" aria-label="Breadcrumb">
      <ol class="list-none p-0 inline-flex gap-2">
        <li class="flex items-center">
          <a href="/" class="hover:text-maroon-deep">Home</a>
          <span class="mx-2">/</span>
        </li>
        <li class="text-maroon-deep truncate max-w-[200px]" aria-current="page">
          Blog & Hymn Library
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <div class="text-center space-y-3">
      <span class="text-xs font-bold tracking-widest text-maroon-deep bg-marigold/30 px-3 py-1 rounded border border-marigold">
        Spiritual Wisdom (ज्ञान गंगा)
      </span>
      <h1 class="font-serif-display text-3xl sm:text-4xl uppercase tracking-wider font-bold text-maroon-deep">
        Bhakti Blog & Scripture Library
      </h1>
      <p class="text-xs sm:text-sm text-charcoal-brown/70 leading-relaxed max-w-2xl mx-auto">
        Explore authentic stotras, chalisas, aartis, and devotional hymns with lyrics in Hindi & English, meanings, recitation rules, and spiritual context.
      </p>
    </div>

    <CarvedDivider icon="📖" />

    <!-- Search & Filter Section -->
    <div class="space-y-4 bg-stone-ivory/60 border border-brass-gold/25 p-4 sm:p-6 rounded-xl shadow-xs">
      <!-- Search Box -->
      <form method="get" action="/blog" class="flex flex-col sm:flex-row gap-2">
        <div class="relative flex-1">
          <input
            type="text"
            name="q"
            value={searchQuery}
            placeholder="Search hymns, chalisas, mantras (e.g. Sankat Mochan, Shiv, Ganesh)..."
            class="w-full px-4 py-2 text-xs sm:text-sm bg-stone-ivory border border-brass-gold/40 rounded focus:outline-none focus:border-maroon-deep text-charcoal-brown"
          />
          {currentCategory !== "All" && (
            <input type="hidden" name="category" value={currentCategory} />
          )}
        </div>
        <button
          type="submit"
          class="px-5 py-2 text-xs font-bold uppercase tracking-wider bg-maroon-deep hover:bg-marigold text-stone-ivory hover:text-maroon-deep rounded transition-colors"
        >
          Search
        </button>
        {(searchQuery || currentCategory !== "All") && (
          <a
            href="/blog"
            class="px-4 py-2 text-xs font-semibold text-charcoal-brown/70 hover:text-maroon-deep border border-brass-gold/30 rounded flex items-center justify-center transition-colors"
          >
            Clear Filters
          </a>
        )}
      </form>

      <!-- Category Tabs -->
      <div class="flex flex-wrap gap-2 pt-2 border-t border-brass-gold/15">
        {allCategories.map((cat) => {
          const isSelected = currentCategory === cat;
          const targetUrl = cat === "All" 
            ? (searchQuery ? `/blog?q=${encodeURIComponent(searchQuery)}` : "/blog")
            : `/blog?category=${encodeURIComponent(cat)}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ""}`;
          return (
            <a
              href={targetUrl}
              class={`px-3 py-1.5 text-xs font-semibold rounded-full border transition-all ${
                isSelected
                  ? "bg-maroon-deep text-stone-ivory border-maroon-deep shadow-xs"
                  : "bg-stone-ivory text-charcoal-brown/80 border-brass-gold/30 hover:border-maroon-deep hover:text-maroon-deep"
              }`}
            >
              {cat}
            </a>
          );
        })}
      </div>
    </div>

    <!-- AdSense Top Slot -->
    <div class="no-print w-full h-24 bg-stone-ivory border border-brass-gold/20 flex items-center justify-center text-xs text-charcoal-brown/40 tracking-widest uppercase rounded shadow-inner">
      Ad Slot — Blog Top (Layout Stable)
    </div>

    <!-- Main Articles Content -->
    <div class="space-y-6">
      <!-- Results Counter -->
      <div class="flex justify-between items-center text-xs text-charcoal-brown/60 px-1 font-semibold">
        <span>Showing {filteredPosts.length > 0 ? (page - 1) * pageSize + 1 : 0} – {Math.min(page * pageSize, filteredPosts.length)} of {filteredPosts.length} devotional articles</span>
        {totalPages > 1 && (
          <span>Page {page} of {totalPages}</span>
        )}
      </div>

      <!-- Articles Grid -->
      {paginatedPosts.length === 0 ? (
        <div class="p-12 text-center bg-[#F8F2E6] border border-[#E8D7B7] rounded-[16px] space-y-3">
          <p class="text-base text-charcoal-brown/80">No articles found matching your search.</p>
          <a href="/blog" class="inline-block text-xs font-bold text-maroon-deep underline">View All Articles</a>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {paginatedPosts.map((post, index) => {
            const image = post.featuredImage || "/images/default-blog-cover.webp";
            return (
              <article class="group flex flex-col h-full overflow-hidden rounded-[16px] bg-[#F8F2E6] border border-[#E8D7B7] shadow-[0_3px_10px_rgba(80,45,20,0.08)] transition-all duration-[250ms] ease-out hover:-translate-y-1 hover:shadow-[0_12px_24px_rgba(80,45,20,0.14)]">
                <!-- Featured Image (Aspect Ratio 5:4) -->
                <a href={`/blog/${post.slug}`} class="block relative w-full aspect-[5/4] overflow-hidden rounded-t-[16px] bg-stone-ivory/60">
                  <img
                    src={image}
                    alt={post.title}
                    loading={index < 3 ? "eager" : "lazy"}
                    decoding="async"
                    class="w-full h-full object-cover rounded-t-[16px] transition-transform duration-[250ms] ease-out group-hover:scale-[1.04]"
                  />
                </a>

                <!-- Card Body -->
                <div class="p-5 flex flex-col flex-grow justify-between gap-4">
                  <div class="space-y-3">
                    <!-- Category Pill -->
                    {post.category && (
                      <div>
                        <span class="inline-flex items-center px-2.5 py-0.5 text-[11px] font-semibold tracking-wide rounded-[999px] bg-[#F4E4B8] text-[#7A1F1F]">
                          {post.category}
                        </span>
                      </div>
                    )}

                    <!-- Meta Row -->
                    <div class="flex items-center gap-1.5 text-[13px] text-[#B8892E] font-medium truncate">
                      <span>{post.createdAt}</span>
                      <span>•</span>
                      <span class="truncate">By {post.author}</span>
                      <span>•</span>
                      <span class="whitespace-nowrap">{post.readTime}</span>
                    </div>

                    <!-- Title -->
                    <h2 class="font-serif-display text-[26px] sm:text-[31px] font-[700] text-[#6E1E1E] leading-[1.25] line-clamp-2">
                      <a href={`/blog/${post.slug}`} class="hover:text-vermilion transition-colors">
                        {post.title}
                      </a>
                    </h2>

                    <!-- Excerpt -->
                    <p class="text-[15px] text-[#5B5248] leading-relaxed line-clamp-3">
                      {post.excerpt}
                    </p>
                  </div>

                  <!-- CTA Button -->
                  <div class="pt-2 border-t border-[#E8D7B7]/40">
                    <a
                      href={`/blog/${post.slug}`}
                      class="inline-flex items-center gap-1 text-[13px] font-bold uppercase text-[#B75A14] hover:text-[#6E1E1E] tracking-wider transition-colors"
                    >
                      READ FULL HYMN &amp; LYRICS &rarr;
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )}

      <!-- Pagination Controls -->
      {totalPages > 1 && (
        <nav class="flex justify-center items-center gap-2 pt-8" aria-label="Pagination">
          {page > 1 && (
            <a
              href={`/blog?page=${page - 1}${currentCategory !== "All" ? `&category=${encodeURIComponent(currentCategory)}` : ""}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ""}`}
              class="px-4 py-2 text-xs font-bold rounded-full border border-[#B8892E] text-[#6E1E1E] bg-[#F8F2E6] hover:bg-[#6E1E1E] hover:text-[#F8F2E6] transition-colors shadow-xs"
            >
              &larr; Previous
            </a>
          )}

          <div class="flex items-center gap-1.5">
            {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
              let pageNum = i + 1;
              if (totalPages > 5 && page > 3) {
                pageNum = page - 2 + i;
                if (pageNum > totalPages) pageNum = totalPages - (4 - i);
              }
              const isCurr = pageNum === page;
              return (
                <a
                  href={`/blog?page=${pageNum}${currentCategory !== "All" ? `&category=${encodeURIComponent(currentCategory)}` : ""}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ""}`}
                  class={`w-9 h-9 flex items-center justify-center text-xs font-bold rounded-full border transition-all ${
                    isCurr
                      ? "bg-[#6E1E1E] text-[#F8F2E6] border-[#B8892E] shadow-sm ring-1 ring-[#B8892E]"
                      : "bg-[#F8F2E6] text-[#6E1E1E] border border-[#B8892E] hover:bg-[#6E1E1E] hover:text-[#F8F2E6]"
                  }`}
                >
                  {pageNum}
                </a>
              );
            })}
          </div>

          {page < totalPages && (
            <a
              href={`/blog?page=${page + 1}${currentCategory !== "All" ? `&category=${encodeURIComponent(currentCategory)}` : ""}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ""}`}
              class="px-4 py-2 text-xs font-bold rounded-full border border-[#B8892E] text-[#6E1E1E] bg-[#F8F2E6] hover:bg-[#6E1E1E] hover:text-[#F8F2E6] transition-colors shadow-xs"
            >
              Next &rarr;
            </a>
          )}
        </nav>
      )}
    </div>

    <!-- AdSense Footer Slot -->
    <div class="no-print w-full h-24 bg-stone-ivory border border-brass-gold/20 flex items-center justify-center text-xs text-charcoal-brown/40 tracking-widest uppercase rounded shadow-inner my-12">
      Ad Slot — Blog Bottom (Layout Stable)
    </div>

  </div>
</Layout>

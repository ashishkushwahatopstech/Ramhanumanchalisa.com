---
import Layout from "../layouts/Layout.astro";
import CarvedDivider from "../components/CarvedDivider";
import hanumanChalisaData from "../data/scriptures/hanuman-chalisa.json";
import type { ScriptureVerse } from "../types/scripture";

const verses = hanumanChalisaData as ScriptureVerse[];

const title = "Hanuman Chalisa Lyrics in English — Transliteration Guide";
const description = "Read full Hanuman Chalisa lyrics in English transliteration with romanized phonetic syllables, line-by-line translation, and easy English chanting guide.";

const scriptureSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "inLanguage": "en",
  "mainEntityOfPage": "https://ramhanumanchalisa.com/hanuman-chalisa-english",
  "author": {
    "@type": "Organization",
    "name": "Ram Hanuman Chalisa",
    "url": "https://ramhanumanchalisa.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Ram Hanuman Chalisa",
    "url": "https://ramhanumanchalisa.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://ramhanumanchalisa.com/icon.png"
    }
  }
};

const compositionSchema = {
  "@context": "https://schema.org",
  "@type": "MusicComposition",
  "@id": "https://ramhanumanchalisa.com/hanuman-chalisa-english#composition",
  "name": "Hanuman Chalisa in English",
  "alternativeHeadline": "श्री हनुमान चालीसा",
  "description": description,
  "inLanguage": "en",
  "genre": "Devotional / Hindu Hymn / Stotra",
  "composer": {
    "@type": "Person",
    "name": "Goswami Tulsidas",
    "sameAs": "https://en.wikipedia.org/wiki/Tulsidas"
  },
  "lyricist": {
    "@type": "Person",
    "name": "Goswami Tulsidas"
  },
  "lyrics": {
    "@type": "MusicLyric",
    "text": verses.map((v) => `${v.title || v.id}: ${v.transliteration || v.devanagari}`).join("\n"),
    "inLanguage": "en"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Ram Hanuman Chalisa",
    "url": "https://ramhanumanchalisa.com",
    "logo": "https://ramhanumanchalisa.com/icon.png"
  }
};
---

<Layout title={title} description={description}>
  <!-- Scripture & Composition Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(scriptureSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(compositionSchema)} />

  <div class="space-y-10 max-w-5xl mx-auto">
    
    <!-- Breadcrumbs -->
    <nav class="text-xs text-charcoal-brown/50 font-semibold" aria-label="Breadcrumb">
      <ol class="list-none p-0 inline-flex gap-2">
        <li class="flex items-center">
          <a href="/" class="hover:text-maroon-deep">Home</a>
          <span class="mx-2">/</span>
        </li>
        <li class="text-maroon-deep truncate max-w-[200px]" aria-current="page">
          English Lyrics
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <div class="text-center space-y-3">
      <span class="text-xs font-bold tracking-widest text-maroon-deep bg-marigold/30 px-3 py-1 rounded border border-marigold">
        Romanized Translation (English Script)
      </span>
      <h1 class="font-serif-display text-3xl uppercase tracking-wider font-bold text-maroon-deep">
        Hanuman Chalisa English Lyrics
      </h1>
      <p class="text-xs text-charcoal-brown/70 max-w-xl mx-auto leading-relaxed">
        Perfect for daily recitation if you cannot read Devanagari. Follow the transliterated English syllables along with direct translation.
      </p>
    </div>

    <!-- Cannibalization Resolution Cross-Link Banner -->
    <div class="p-4 bg-maroon-deep/5 border border-brass-gold/30 rounded-lg flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-charcoal-brown">
      <div>
        <strong class="text-maroon-deep">Looking for full bilingual edition with audio player?</strong>
        <p class="text-charcoal-brown/75">Explore the comprehensive Hanuman Chalisa with Devanagari script, audio synchronization, and PDF download.</p>
      </div>
      <a
        href="/hanuman-chalisa/en"
        class="shrink-0 px-4 py-2 bg-maroon-deep hover:bg-marigold text-stone-ivory hover:text-maroon-deep font-bold rounded uppercase tracking-wider border border-brass-gold shadow-sm transition-colors text-[11px]"
      >
        Complete English Edition &rarr;
      </a>
    </div>

    <CarvedDivider icon="🕉️" />

    <!-- AdSense Slot -->
    <div class="no-print w-full h-24 bg-stone-ivory border border-brass-gold/20 flex items-center justify-center text-xs text-charcoal-brown/40 tracking-widest uppercase rounded shadow-inner">
      Ad Slot — Lyrics Page Top (Layout Stable Skeleton)
    </div>

    <!-- Section Heading -->
    <div class="text-center">
      <h2 class="font-serif-display text-xl sm:text-2xl font-bold text-maroon-deep uppercase tracking-wider">
        All 43 Verses in Romanized English
      </h2>
      <p class="text-xs text-charcoal-brown/60 mt-1">2 Opening Dohas, 40 Chaupais & 1 Concluding Couplet</p>
    </div>

    <!-- Verses Layout -->
    <div class="space-y-8">
      {verses.map((verse) => {
        const isDoha = verse.id.startsWith("doha-");
        const verseLabel = isDoha
          ? verse.id === "doha-01"
            ? "Opening Doha 1"
            : verse.id === "doha-02"
            ? "Opening Doha 2"
            : "Concluding Doha"
          : `Chaupai ${verse.verse_number}`;

        return (
          <div
            class="p-6 bg-stone-ivory border border-brass-gold/30 rounded shadow-sm hover:shadow-md transition-shadow duration-200"
          >
            <div class="text-[10px] font-bold text-brass-gold tracking-widest uppercase mb-3">
              {verseLabel}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-8">
              
              {/* English Transliteration */}
              <div class="space-y-1">
                <p class="font-serif-display text-base sm:text-lg font-bold text-maroon-deep leading-relaxed whitespace-pre-line">
                  {verse.transliteration}
                </p>
                <p class="text-[10px] text-charcoal-brown/40 uppercase font-bold tracking-widest pt-1">
                  Transliteration / Syllables
                </p>
              </div>

              {/* English Translation */}
              <div class="flex flex-col justify-center border-t md:border-t-0 md:border-l border-brass-gold/20 pt-3 md:pt-0 md:pl-6">
                <p class="text-xs sm:text-sm text-charcoal-brown/90 leading-relaxed font-semibold">
                  {verse.literal_translation.en}
                </p>
                <p class="text-xs text-charcoal-brown/60 mt-2 leading-relaxed">
                  {verse.interpretive_meaning.en}
                </p>
              </div>

            </div>

          </div>
        );
      })}
    </div>

    <!-- AdSense Slot -->
    <div class="no-print w-full h-24 bg-stone-ivory border border-brass-gold/20 flex items-center justify-center text-xs text-charcoal-brown/40 tracking-widest uppercase rounded shadow-inner my-12">
      Ad Slot — Lyrics Page Bottom (Layout Stable Skeleton)
    </div>

  </div>
</Layout>

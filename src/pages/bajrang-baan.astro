---
import Layout from "../layouts/Layout.astro";
import CarvedDivider from "../components/CarvedDivider";
import PageFaqs from "../components/PageFaqs.astro";
import bajrangBaanData from "../data/scriptures/bajrang-baan.json";
import type { ScriptureVerse } from "../types/scripture";

const verses = bajrangBaanData as ScriptureVerse[];

const openingDohas = verses.filter((v) => v.id.startsWith("doha-") && v.id !== "doha-closing");
const closingDoha = verses.find((v) => v.id === "doha-closing");
const chaupais = verses.filter((v) => v.id.startsWith("chaupai-"));

const title = "Shree Bajrang Baan Lyrics — Hindi, English & Path Vidhi";
const description = "Read Shree Bajrang Baan lyrics in Hindi & English with line-by-line meaning, authentic path vidhi, and protection benefits.";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "inLanguage": "en",
  "datePublished": "2024-01-15T00:00:00.000Z",
  "dateModified": "2026-09-02T12:00:00.000Z",
  "mainEntityOfPage": "https://ramhanumanchalisa.com/bajrang-baan",
  "author": {
    "@type": "Organization",
    "name": "Ram Hanuman Chalisa",
    "url": "https://ramhanumanchalisa.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Ram Hanuman Chalisa",
    "url": "https://ramhanumanchalisa.com/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://ramhanumanchalisa.com/icon.png"
    }
  }
};

const compositionSchema = {
  "@context": "https://schema.org",
  "@type": "MusicComposition",
  "@id": "https://ramhanumanchalisa.com/bajrang-baan#composition",
  "name": "Shree Bajrang Baan (श्री बजरंग बाण)",
  "alternativeHeadline": "श्री बजरंग बाण",
  "description": description,
  "inLanguage": "hi",
  "genre": "Devotional / Hindu Hymn / Stotra",
  "composer": {
    "@type": "Person",
    "name": "Goswami Tulsidas",
    "sameAs": "https://en.wikipedia.org/wiki/Tulsidas"
  },
  "lyricist": {
    "@type": "Person",
    "name": "Goswami Tulsidas"
  },
  "lyrics": {
    "@type": "CreativeWork",
    "text": verses.map((v) => `${v.title || v.id}:\n${v.devanagari}\n${v.transliteration}`).join("\n\n"),
    "inLanguage": "hi"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Ram Hanuman Chalisa",
    "url": "https://ramhanumanchalisa.com/",
    "logo": "https://ramhanumanchalisa.com/icon.png"
  }
};
---

<Layout title={title} description={description} lang="hi">
  <!-- Article & Composition JSON-LD Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(compositionSchema)} />

  <div class="space-y-10 max-w-4xl mx-auto">
    
    <!-- Breadcrumbs -->
    <nav class="text-xs text-charcoal-brown/50 font-semibold" aria-label="Breadcrumb">
      <ol class="list-none p-0 inline-flex gap-2">
        <li class="flex items-center">
          <a href="/" class="hover:text-maroon-deep">Home</a>
          <span class="mx-2">/</span>
        </li>
        <li class="text-maroon-deep truncate max-w-[200px]" aria-current="page">
          Bajrang Baan
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <div class="text-center space-y-3">
      <span class="rubric-marker">
        सुरक्षा कवच • Protection Shield
      </span>
      <h1 class="font-serif-display text-3xl uppercase tracking-wider font-bold text-maroon-deep">
        Shree Bajrang Baan
      </h1>
      <p class="text-xs text-charcoal-brown/70 max-w-xl mx-auto leading-relaxed">
        The Bajrang Baan is an arrow (baan) of protection dedicated to Lord Hanuman. Devotees chant it to dispel fear, remove negative influences, and overcome severe obstacles.
      </p>
    </div>

    <CarvedDivider icon="🏹" />

    <!-- AdSense Top Slot -->
    <div class="no-print w-full h-24 bg-stone-ivory border border-brass-gold/20 flex items-center justify-center text-xs text-charcoal-brown/40 tracking-widest uppercase rounded shadow-inner">
      Ad Slot — Page Top (Layout Stable)
    </div>

    <!-- 1. Opening Dohas -->
    {openingDohas.length > 0 && (
      <section class="manuscript-frame p-6 sm:p-8 bg-[#FAF6EE] border-2 border-brass-gold/50 text-charcoal-brown shadow-sm text-center space-y-4 max-w-2xl mx-auto">
        <span class="rubric-marker">
          Opening Couplets (दोहा)
        </span>
        {openingDohas.map((doha) => (
          <div class="space-y-2">
            <p class="font-hindi-display text-lg sm:text-xl leading-loose font-bold text-maroon-deep">
              {doha.devanagari}
            </p>
            <p class="text-xs text-charcoal-brown/60 italic">
              {doha.transliteration}
            </p>
            <p class="text-xs sm:text-sm font-semibold text-vermilion">
              {doha.literal_translation.en}
            </p>
          </div>
        ))}
      </section>
    )}

    <!-- 2. Main Verses (Chaupais) -->
    <section class="space-y-6">
      <div class="text-center space-y-1">
        <span class="rubric-marker">॥ श्री बजरंग बाण पाठ ॥</span>
        <h2 class="font-serif-display text-2xl uppercase tracking-wider font-bold text-maroon-deep">
          The Bajrang Baan Verses
        </h2>
      </div>

      <div class="manuscript-frame bg-[#FAF6EE] border-2 border-brass-gold/40 shadow-sm divide-y divide-brass-gold/20">
        {chaupais.map((verse) => (
          <div
            class="p-6 sm:p-8 space-y-4 hover:bg-[#F3EBDD]/40 transition-colors"
          >
            <div class="flex items-center justify-between border-b border-brass-gold/15 pb-2">
              <span class="rubric-marker">
                ॥ बाण चौपाई {verse.verse_number} ॥
              </span>
              <span class="text-[10px] font-mono tracking-widest text-charcoal-brown/40 uppercase">
                Verse {verse.verse_number}
              </span>
            </div>

            <!-- Devanagari -->
            <p class="font-hindi-display text-lg sm:text-xl text-maroon-deep tracking-wide leading-loose text-center font-bold">
              {verse.devanagari}
            </p>

            <!-- Transliteration -->
            <p class="text-xs text-center text-charcoal-brown/70 italic max-w-lg mx-auto">
              {verse.transliteration}
            </p>

            <!-- English Translation -->
            <div class="border-t border-brass-gold/25 pt-3">
              <p class="text-xs sm:text-sm text-charcoal-brown leading-relaxed text-center font-semibold">
                {verse.literal_translation.en}
              </p>
              {verse.interpretive_meaning && verse.interpretive_meaning.en && (
                <p class="text-[11px] text-charcoal-brown/60 mt-1.5 text-center leading-relaxed max-w-2xl mx-auto">
                  {verse.interpretive_meaning.en}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Closing Doha -->
    {closingDoha && (
      <section class="manuscript-frame p-6 sm:p-8 bg-[#2D070B] border-2 border-brass-gold text-stone-ivory shadow-md text-center space-y-3 max-w-2xl mx-auto">
        <span class="rubric-marker">
          Concluding Couplet (दोहा)
        </span>
        <p class="font-hindi-display text-lg sm:text-xl leading-loose font-bold text-marigold">
          {closingDoha.devanagari}
        </p>
        <p class="text-xs text-stone-ivory/70 italic">
          {closingDoha.transliteration}
        </p>
        <p class="text-xs sm:text-sm font-semibold text-stone-ivory">
          {closingDoha.literal_translation.en}
        </p>
      </section>
    )}

    <!-- 4. Caution Guideline -->
    <section class="manuscript-frame bg-[#FFF7F4] border-2 border-[#C1440E]/40 p-6 space-y-3 text-sm leading-relaxed">
      <h2 class="font-serif-display font-bold uppercase tracking-wider text-vermilion flex items-center gap-1.5 text-base sm:text-lg">
        ⚠️ Important Recitation Warning (सावधानी निर्देश)
      </h2>
      <p class="text-charcoal-brown/95">
        Unlike the Hanuman Chalisa, which is gentle and can be chanted casually at any time, the **Bajrang Baan** contains seed mantras (bij mantras like <i>hrim, klim, shrim</i>) and involves making a vow (shapath) in the name of Lord Rama to compel Hanuman to act.
      </p>
      <p class="text-charcoal-brown/85">
        Therefore, traditional pandits advise that the Bajrang Baan should **only** be recited when facing severe crisis, extreme fear, or insurmountable difficulties. It should not be chanted for trivial desires or material greed, and the chanter must maintain high physical and moral cleanliness (such as avoiding non-vegetarian food).
      </p>
    </section>

    <!-- Related Content Links -->
    <section class="bg-stone-ivory border border-brass-gold/25 p-6 rounded-lg text-center space-y-3">
      <h2 class="font-serif-display text-sm sm:text-base font-bold uppercase text-maroon-deep">
        Related Devotional Chants (संबंधित पाठ)
      </h2>
      <div class="flex flex-wrap justify-center gap-4 text-xs font-semibold">
        <a href="/" class="text-vermilion hover:text-marigold underline">
          Shree Hanuman Chalisa
        </a>
        <span class="text-brass-gold/40">•</span>
        <a href="/hanuman-chalisa-meaning" class="text-vermilion hover:text-marigold underline">
          Bilingual Meaning
        </a>
        <span class="text-brass-gold/40">•</span>
        <a href="/sankat-mochan-hanumanashtak" class="text-vermilion hover:text-marigold underline">
          Hanumanashtak
        </a>
        <span class="text-brass-gold/40">•</span>
        <a href="/hanuman-aarti" class="text-vermilion hover:text-marigold underline">
          Hanuman Aarti
        </a>
      </div>
    </section>

    <!-- Reusable Dynamic Page FAQs -->
    <PageFaqs
      pageSlug="bajrang-baan"
      title="Bajrang Baan FAQs & Precautions"
    />

    <!-- AdSense Footer Slot -->
    <div class="no-print w-full h-24 bg-stone-ivory border border-brass-gold/20 flex items-center justify-center text-xs text-charcoal-brown/40 tracking-widest uppercase rounded shadow-inner my-12">
      Ad Slot — Page Bottom (Layout Stable)
    </div>

  </div>
</Layout>

---
import Layout from "../../../layouts/Layout.astro";
import AdminNavigation from "../../../components/AdminNavigation.astro";
import VisualBlockEditor from "../../../components/pagebuilder/admin/VisualBlockEditor";
import { getPageBySlugWithDb } from "../../../lib/pagebuilder/store";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/admin/pagebuilder");
}

const db = (Astro.locals as any)?.runtime?.env?.DB;
const initialPage = await getPageBySlugWithDb(slug, db);

const title = `Edit Page /${slug} — Visual Block Editor`;
---

<Layout title={title} hideSidebar={true}>
  <div class="max-w-7xl mx-auto space-y-6">
    <AdminNavigation activeTab="pagebuilder" />

    <section>
      <VisualBlockEditor client:load initialSlug={slug} initialPageData={initialPage} />
    </section>
  </div>
</Layout>

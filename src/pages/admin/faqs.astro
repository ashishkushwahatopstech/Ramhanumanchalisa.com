---
import Layout from "../../layouts/Layout.astro";
import AdminNavigation from "../../components/AdminNavigation.astro";
import FaqManagerForm from "../../components/FaqManagerForm";
import { getPrisma } from "../../lib/prisma";

const db = Astro.locals.runtime?.env?.DB;
const prisma = getPrisma(db);

let initialFaqs: any[] = [];
try {
  initialFaqs = await prisma.faq.findMany({
    orderBy: [
      { pageSlug: "asc" },
      { order: "asc" },
    ],
  });
} catch (error) {
  console.error("Error pre-loading FAQs for admin:", error);
}

const title = "Global FAQ Content Manager — Admin";
---

<Layout title={title}>
  <div class="max-w-5xl mx-auto space-y-6">
    <AdminNavigation activeTab="faqs" />

    <!-- Faq Manager Client Form -->
    <FaqManagerForm initialFaqs={initialFaqs} client:load />
  </div>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import CarvedDivider from "../../components/CarvedDivider";
import LanguageManagerForm from "../../components/LanguageManagerForm";

const title = "Multi-Language Manager";
---

<Layout title={title}>
  <div class="space-y-8 max-w-4xl mx-auto">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 bg-maroon-deep border-2 border-brass-gold p-6 rounded-lg text-stone-ivory">
      <div class="space-y-1">
        <h2 class="font-serif-display text-xl sm:text-2xl font-bold text-marigold uppercase text-center sm:text-left">
          Multi-Language Manager
        </h2>
        <p class="text-xs text-stone-ivory/80 text-center sm:text-left">
          Configure regional translations, page titles, and schema metadata.
        </p>
      </div>
      <div>
        <a
          href="/admin"
          class="bg-stone-ivory/10 hover:bg-stone-ivory/20 px-4 py-2 rounded text-xs font-bold uppercase border border-stone-ivory/30 shadow transition-colors block text-center"
        >
          &larr; Admin Dashboard
        </a>
      </div>
    </div>

    <CarvedDivider icon="🕉️" />

    <!-- Editor Form -->
    <section class="bg-stone-ivory border border-brass-gold/30 p-6 rounded-lg shadow-sm">
      <LanguageManagerForm client:load />
    </section>

  </div>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import AdminNavigation from "../../components/AdminNavigation.astro";
import LanguageManagerForm from "../../components/LanguageManagerForm";

const title = "Multi-Language Manager — Admin";
---

<Layout title={title}>
  <div class="max-w-5xl mx-auto space-y-6">
    <AdminNavigation activeTab="languages" />

    <!-- Editor Form -->
    <section class="bg-stone-ivory border border-brass-gold/30 p-6 rounded-lg shadow-sm">
      <LanguageManagerForm client:load />
    </section>
  </div>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import CarvedDivider from "../../components/CarvedDivider";
import JayantiManagerForm from "../../components/JayantiManagerForm";
import { getPrisma } from "../../lib/prisma";

const db = Astro.locals.runtime?.env?.DB;
const prisma = getPrisma(db);

let initialConfigs: any[] = [];
try {
  initialConfigs = await prisma.jayantiConfig.findMany({
    orderBy: { year: "desc" },
  });
} catch (error) {
  console.error("Error pre-loading Jayanti configs:", error);
}

const title = "Jayanti Festival Configurations";
---

<Layout title={title}>
  <div class="space-y-8 max-w-4xl mx-auto">
    
    <!-- Header -->
    <div class="flex justify-between items-center bg-maroon-deep border-2 border-brass-gold p-4 sm:p-6 rounded-lg text-stone-ivory">
      <div class="space-y-1">
        <h2 class="font-serif-display text-xl sm:text-2xl font-bold text-marigold uppercase">
          Jayanti Festival Configurations
        </h2>
        <p class="text-xs text-stone-ivory/70">
          Configure dates, moon timings (tithis), and recommended puja muhurat periods displayed on the evergreen festival page.
        </p>
      </div>
      <a
        href="/admin"
        class="bg-stone-ivory/10 hover:bg-stone-ivory/20 px-3 py-1.5 rounded text-xs font-bold uppercase border border-stone-ivory/30 shadow transition-colors"
      >
        &larr; Dashboard
      </a>
    </div>

    <CarvedDivider icon="🕉️" />

    <!-- Jayanti Manager Form Component -->
    <JayantiManagerForm initialConfigs={initialConfigs} client:load />

  </div>
</Layout>

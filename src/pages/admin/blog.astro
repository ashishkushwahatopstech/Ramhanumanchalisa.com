---
import Layout from "../../layouts/Layout.astro";
import AdminNavigation from "../../components/AdminNavigation.astro";
import BlogEditorForm from "../../components/BlogEditorForm";
import { getPrisma } from "../../lib/prisma";

const db = Astro.locals.runtime?.env?.DB;
const prisma = getPrisma(db);

let initialPosts: any[] = [];
try {
  const dbPosts = await prisma.post.findMany({
    orderBy: { createdAt: "desc" },
  });
  // Serialize Dates to string for hydration-safe transfer
  initialPosts = dbPosts.map((p) => ({
    ...p,
    createdAt: p.createdAt.toISOString(),
    updatedAt: p.updatedAt.toISOString(),
  }));
} catch (error) {
  console.error("Error fetching admin blog list:", error);
}

const title = "Blog Articles SEO Studio — Admin";
---

<Layout title={title}>
  <div class="max-w-5xl mx-auto space-y-6">
    <AdminNavigation activeTab="blog" />

    <!-- Editor Form Component (Client Side) -->
    <BlogEditorForm initialPosts={initialPosts} client:load />
  </div>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import CarvedDivider from "../../components/CarvedDivider";
import BlogEditorForm from "../../components/BlogEditorForm";
import { getPrisma } from "../../lib/prisma";

const db = Astro.locals.runtime?.env?.DB;
const prisma = getPrisma(db);

let initialPosts: any[] = [];
try {
  const dbPosts = await prisma.post.findMany({
    orderBy: { createdAt: "desc" },
  });
  // Serialize Dates to string for hydration-safe transfer
  initialPosts = dbPosts.map(p => ({
    ...p,
    createdAt: p.createdAt.toISOString(),
    updatedAt: p.updatedAt.toISOString()
  }));
} catch (error) {
  console.error("Error fetching admin blog list:", error);
}

const title = "Blog Articles Manager";
---

<Layout title={title}>
  <div class="space-y-8 max-w-4xl mx-auto">
    
    <!-- Header -->
    <div class="flex justify-between items-center bg-maroon-deep border-2 border-brass-gold p-4 sm:p-6 rounded-lg text-stone-ivory">
      <div class="space-y-1">
        <h2 class="font-serif-display text-xl sm:text-2xl font-bold text-marigold uppercase">
          Blog Articles Manager
        </h2>
        <p class="text-xs text-stone-ivory/70">
          Publish SEO articles to improve search indexing and provide E-E-A-T background value.
        </p>
      </div>
      <a
        href="/admin"
        class="bg-stone-ivory/10 hover:bg-stone-ivory/20 px-3 py-1.5 rounded text-xs font-bold uppercase border border-stone-ivory/30 shadow transition-colors"
      >
        &larr; Dashboard
      </a>
    </div>

    <CarvedDivider icon="🕉️" />

    <!-- Editor Form Component (Client Side) -->
    <BlogEditorForm initialPosts={initialPosts} client:load />

  </div>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import AdminNavigation from "../../components/AdminNavigation.astro";
import BenefitEditorForm from "../../components/BenefitEditorForm";
import { getPrisma } from "../../lib/prisma";
import { BENEFITS_DATA } from "../../data/benefits";
import { getAllCachedBenefits } from "../../lib/dynamicContent";
import { d1GetBenefits } from "../../lib/d1";

const db = Astro.locals.runtime?.env?.DB;
let dbBenefits: any[] = [];

// 1. Native D1 query
if (db && typeof db.prepare === "function") {
  try {
    dbBenefits = await d1GetBenefits(db);
  } catch (e) {
    console.warn("Notice: D1 getBenefits in admin/benefits.astro:", e);
  }
}

// 2. Prisma fallback
if (dbBenefits.length === 0) {
  const prisma = getPrisma(db);
  if (prisma) {
    try {
      const result = await prisma.benefit.findMany({
        orderBy: { createdAt: "desc" },
      });
      if (result && Array.isArray(result)) {
        dbBenefits = result.map((b) => ({
          ...b,
          createdAt: b.createdAt ? new Date(b.createdAt).toISOString() : new Date().toISOString(),
          updatedAt: b.updatedAt ? new Date(b.updatedAt).toISOString() : new Date().toISOString(),
        }));
      }
    } catch (error) {
      console.warn("Notice: DB benefits query fallback to static:", error);
    }
  }
}

// Ensure all published fallback benefits are always merged and present
const dbSlugs = new Set(dbBenefits.map((b) => b.slug));

// Merge cached benefits
const cachedBenefits = getAllCachedBenefits().filter((b) => !dbSlugs.has(b.slug));
cachedBenefits.forEach((b) => dbSlugs.add(b.slug));

const fallbackList = Object.values(BENEFITS_DATA).filter((b) => !dbSlugs.has(b.slug)).map((b) => ({
  id: `fallback-${b.slug}`,
  slug: b.slug,
  title: b.title,
  situation: b.situation,
  icon: b.icon || "🙏",
  description: b.description,
  recommendedChants: b.recommendedChants || "",
  targetVerseNumber: b.targetVerseNumber || 1,
  targetVerseText: b.targetVerseText || "",
  targetVerseTranslation: b.targetVerseTranslation || "",
  detailedExposition: b.detailedExposition || "",
  actionSteps: b.actionSteps ? JSON.stringify(b.actionSteps) : "[]",
  published: true,
  createdAt: new Date().toISOString(),
  updatedAt: new Date().toISOString(),
}));

const initialBenefits = [...dbBenefits, ...cachedBenefits, ...fallbackList];
const title = "Hanuman Chalisa Benefits SEO Studio — Admin";
---

<Layout title={title}>
  <div class="max-w-5xl mx-auto space-y-6">
    <AdminNavigation activeTab="benefits" />

    <!-- Benefit Editor Form Component (Client Side) -->
    <BenefitEditorForm initialBenefits={initialBenefits} client:load />
  </div>
</Layout>

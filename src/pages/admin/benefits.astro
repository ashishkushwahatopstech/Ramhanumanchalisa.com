---
import Layout from "../../layouts/Layout.astro";
import AdminNavigation from "../../components/AdminNavigation.astro";
import BenefitEditorForm from "../../components/BenefitEditorForm";
import { getPrisma } from "../../lib/prisma";

const db = Astro.locals.runtime?.env?.DB;
const prisma = getPrisma(db);

let initialBenefits: any[] = [];
try {
  const dbBenefits = await prisma.benefit.findMany({
    orderBy: { createdAt: "desc" },
  });
  initialBenefits = dbBenefits.map((b) => ({
    ...b,
    createdAt: b.createdAt.toISOString(),
    updatedAt: b.updatedAt.toISOString(),
  }));
} catch (error) {
  console.error("Error fetching admin benefits list:", error);
}

const title = "Hanuman Chalisa Benefits SEO Studio — Admin";
---

<Layout title={title}>
  <div class="max-w-5xl mx-auto space-y-6">
    <AdminNavigation activeTab="benefits" />

    <!-- Benefit Editor Form Component (Client Side) -->
    <BenefitEditorForm initialBenefits={initialBenefits} client:load />
  </div>
</Layout>

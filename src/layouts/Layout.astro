---
import LanguageSwitcher from "../components/LanguageSwitcher";
import SearchModal from "../components/SearchModal";
import ScrollToTop from "../components/ScrollToTop.astro";
import Sidebar from "../components/Sidebar.astro";
import AdSlot from "../components/AdSlot.astro";
import DesktopSideDock, { MobileBottomActionDock } from "../components/DesktopSideDock";
import { d1GetBlogConfig, d1GetSiteConfig } from "../lib/d1";
import { getBlogConfig } from "../lib/dynamicContent";
import { getSiteLayoutConfig, type SiteLayoutConfig } from "../lib/siteConfig";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  showHreflangs?: boolean;
  lang?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageType?: string;
  ogType?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  hideSidebar?: boolean;
  noindex?: boolean;
}

const { 
  title = "Hanuman Chalisa Lyrics with Meaning | Ram Hanuman Chalisa", 
  description = "Read authentic Shree Hanuman Chalisa in Hindi and English with line-by-line meaning, synced audio, printable PDF, and complete path vidhi guidelines.",
  canonicalUrl: propCanonicalUrl,
  showHreflangs = false,
  lang = "en",
  ogImage: rawOgImage = "https://ramhanumanchalisa.com/og-image.jpg",
  ogImageAlt,
  ogImageType,
  ogType = "website",
  ogImageWidth = 1200,
  ogImageHeight = 630,
  hideSidebar = false,
  noindex = false,
} = Astro.props;

// Determine whether sidebar should appear across the site
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

const isExcludedPage = 
  hideSidebar ||
  currentPath === "/" ||
  currentPath === "/faq" ||
  currentPath === "/about" ||
  currentPath === "/contact" ||
  currentPath === "/privacy-policy" ||
  currentPath === "/disclaimer" ||
  currentPath.startsWith("/admin") ||
  currentPath.startsWith("/api") ||
  currentPath.startsWith("/login") ||
  currentPath === "/404" ||
  currentPath === "/unauthorized";

const db = Astro.locals.runtime?.env?.DB;
let siteConfig: SiteLayoutConfig | null = null;
let blogConfig = null;

if (db && typeof db.prepare === "function") {
  try {
    siteConfig = await d1GetSiteConfig(db);
    blogConfig = await d1GetBlogConfig(db);
  } catch (e) {
    // ignore
  }
}

if (!siteConfig) {
  siteConfig = getSiteLayoutConfig();
}
if (!blogConfig) {
  blogConfig = getBlogConfig();
}

const shouldShowSidebar = !isExcludedPage && (siteConfig?.sidebarEnabled ?? (blogConfig?.sidebarEnabled ?? true));
const showSideDock = currentPath !== "/" && !currentPath.startsWith("/admin") && !currentPath.startsWith("/api") && currentPath !== "/login" && currentPath !== "/404";

// Determine canonical URL: prefer explicitly passed prop, otherwise derive dynamically from current route
const siteBaseUrl = "https://ramhanumanchalisa.com";
const cleanPath = Astro.url.pathname.replace(/\/+$/, "");
const canonicalUrl = propCanonicalUrl || (cleanPath ? `${siteBaseUrl}${cleanPath}` : `${siteBaseUrl}/`);

// Resolve absolute OG image URL, MIME type, and alt text
const resolvedOgImage = rawOgImage.startsWith("http")
  ? rawOgImage
  : `${siteBaseUrl}${rawOgImage.startsWith("/") ? "" : "/"}${rawOgImage}`;

let resolvedOgImageType = ogImageType;
if (!resolvedOgImageType) {
  const lowerImg = resolvedOgImage.toLowerCase().split("?")[0];
  if (lowerImg.endsWith(".webp")) resolvedOgImageType = "image/webp";
  else if (lowerImg.endsWith(".png")) resolvedOgImageType = "image/png";
  else resolvedOgImageType = "image/jpeg";
}

const resolvedOgImageAlt = ogImageAlt || `${title} - RamHanumanChalisa.com`;

// Compute optimal SEO title tag (strictly targeting 50-60 characters)
let renderedTitle = title.trim();
if (renderedTitle.includes("Ram Hanuman Chalisa") || renderedTitle.includes("RamHanumanChalisa")) {
  // Brand already present in title
} else if (renderedTitle.length <= 37) {
  renderedTitle = `${renderedTitle} | Ram Hanuman Chalisa`;
} else if (renderedTitle.length <= 44) {
  renderedTitle = `${renderedTitle} | RHC`;
}

const currentYear = new Date().getFullYear();
const gaId = import.meta.env.PUBLIC_GA_ID || Astro.locals.runtime?.env?.PUBLIC_GA_ID || "G-VBBLMPSKY2";

// Robots directive calculation (index on production, conditional noindex on preview/staging)
const host = Astro.url.hostname;
const isPreviewEnv = 
  import.meta.env.PUBLIC_INDEXING_DISABLED === "true" ||
  host.endsWith("pages.dev") ||
  noindex;

const robotsDirective = isPreviewEnv
  ? "noindex, nofollow"
  : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1";

// Compute BreadcrumbList Schema dynamically
const urlObj = new URL(canonicalUrl);
const pathName = urlObj.pathname;
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://ramhanumanchalisa.com/"
  }
];

if (pathName && pathName !== "/") {
  const parts = pathName.split("/").filter(Boolean);
  let accumulatedPath = "";
  parts.forEach((part, index) => {
    accumulatedPath += `/${part}`;
    let name = part
      .replace(/-/g, " ")
      .replace(/\b\w/g, (char) => char.toUpperCase());
    
    if (part === "faq") name = "FAQ";
    else if (part === "hanuman-chalisa-meaning") name = "Meaning";
    else if (part === "hanuman-chalisa-audio-mp3") name = "Synced Audio";
    else if (part === "hanuman-chalisa-pdf") name = "PDF Print";
    else if (part === "sankat-mochan-hanumanashtak") name = "Hanuman Ashtak";
    else if (part === "hanuman-aarti") name = "Hanuman Aarti";
    else if (part === "shri-hanuman-chalisa-path-vidhi") name = "Path Vidhi";
    else if (part === "hanuman-chalisa-benefits") name = "Benefits";
    else if (part === "ram-hanuman-chalisa") name = "Ram Hanuman Connection";
    else if (part === "ram-chalisa") name = "Shri Ram Chalisa";
    else if (part === "hanuman-stuti") name = "Hanuman Stuti";
    else if (part === "blog") name = "Blog";
    else if (part === "en") name = "English";
    else if (part === "te") name = "Telugu";
    else if (part === "bn") name = "Bengali";
    else if (part === "kn") name = "Kannada";
    else if (part === "gu") name = "Gujarati";
    else if (part === "mr") name = "Marathi";
    else if (part === "hi") name = "Hindi";
    
    breadcrumbItems.push({
      "@type": "ListItem",
      "position": index + 2,
      "name": name,
      "item": `https://ramhanumanchalisa.com${accumulatedPath}`
    });
  });
}

const breadcrumbSchema = breadcrumbItems.length >= 2 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
} : null;
---

<!doctype html>
<html lang={lang} class="h-full antialiased">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MJKL5P3X');</script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{renderedTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsDirective} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon & Touch Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    {showHreflangs && (
      <>
        <!-- Hreflang Alternate Translation Tags -->
        <link rel="alternate" hreflang="x-default" href="https://ramhanumanchalisa.com/" />
        <link rel="alternate" hreflang="hi" href="https://ramhanumanchalisa.com/" />
        <link rel="alternate" hreflang="en" href="https://ramhanumanchalisa.com/hanuman-chalisa/en" />
        <link rel="alternate" hreflang="te" href="https://ramhanumanchalisa.com/hanuman-chalisa/te" />
        <link rel="alternate" hreflang="bn" href="https://ramhanumanchalisa.com/hanuman-chalisa/bn" />
        <link rel="alternate" hreflang="kn" href="https://ramhanumanchalisa.com/hanuman-chalisa/kn" />
        <link rel="alternate" hreflang="gu" href="https://ramhanumanchalisa.com/hanuman-chalisa/gu" />
        <link rel="alternate" hreflang="mr" href="https://ramhanumanchalisa.com/hanuman-chalisa/mr" />
      </>
    )}
    
    <!-- Google Fonts Preconnect and Link -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Mukta:wght@200;300;400;500;600;700;800&family=Tiro+Devanagari+Hindi&display=swap" rel="stylesheet" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Ram Hanuman Chalisa" />
    <meta property="og:locale" content={lang === "hi" ? "hi_IN" : (lang === "en" ? "en_IN" : `${lang}_IN`)} />
    <meta property="og:locale:alternate" content={lang === "hi" ? "en_IN" : "hi_IN"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={renderedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:secure_url" content={resolvedOgImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:type" content={resolvedOgImageType} />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={renderedTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={resolvedOgImage} />
    <meta property="twitter:image:alt" content={resolvedOgImageAlt} />

    <!-- Breadcrumb Schema -->
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <!-- Slot for Page Specific Head Elements & Schemas -->
    <slot name="head" />
  </head>
  <body class="min-h-full flex flex-col font-body bg-stone-ivory text-charcoal-brown selection:bg-marigold selection:text-maroon-deep">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MJKL5P3X"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    
    <!-- Top Header / Mandir Entrance -->
    <header class="no-print w-full bg-maroon-deep border-b-4 border-brass-gold text-stone-ivory sticky top-0 z-50 shadow-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          
          <!-- Logo / Title -->
          <a href="/" class="flex items-center gap-2 group">
            <span class="text-2xl sm:text-3xl filter drop-shadow group-hover:scale-110 transition-transform duration-300">🔔</span>
            <div>
              <div class="font-serif-display text-lg sm:text-xl font-bold tracking-wider text-marigold uppercase leading-none">
                Ram Hanuman Chalisa
              </div>
              <p class="text-xs text-brass-gold tracking-widest leading-none mt-1">
                श्री राम जय राम जय जय राम
              </p>
            </div>
          </a>
          
          <!-- Desktop Pillars Nav -->
          <nav class="hidden lg:flex items-center space-x-6 text-sm lg:text-[15px] font-semibold tracking-wide">
            {(siteConfig?.headerMenu || []).filter((item) => item.isEnabled).map((item) => (
              <a
                href={item.href}
                target={item.openNewTab ? "_blank" : undefined}
                rel={item.openNewTab ? "noopener noreferrer" : undefined}
                class="hover:text-marigold transition-colors duration-200 py-2 border-b-2 border-transparent hover:border-marigold"
              >
                {item.label}
              </a>
            ))}
          </nav>

          <!-- Extra Right Button & Language Switcher -->
          <div class="flex items-center gap-2 sm:gap-3">
            <LanguageSwitcher client:idle />

            {siteConfig?.headerCta?.isEnabled && (
              <a
                href={siteConfig.headerCta.href || "/shri-hanuman-chalisa-path-vidhi"}
                class="hidden md:inline-block bg-vermilion hover:bg-[#a63405] text-stone-ivory px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider border border-brass-gold shadow-xs transition-colors"
              >
                {siteConfig.headerCta.label || "How to Recite"}
              </a>
            )}
          </div>

        </div>
      </div>

      <!-- Infinite Sita Ram Chanting Marquee -->
      {siteConfig?.headerNotice?.isEnabled && (
        <div class="w-full bg-marigold text-maroon-deep font-bold py-1.5 border-t border-brass-gold/20 text-xs tracking-wide select-none overflow-hidden">
          <div class="animate-marquee whitespace-nowrap flex motion-reduce:animate-none">
            <span class="font-serif-display shrink-0">&nbsp;{siteConfig.headerNotice.text}&nbsp;</span>
            <span class="font-serif-display shrink-0">&nbsp;{siteConfig.headerNotice.text}&nbsp;</span>
          </div>
        </div>
      )}
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 pb-24 md:pb-12">
      {siteConfig?.adSlots?.aboveFold?.enabled && (
        <AdSlot slotConfig={siteConfig.adSlots.aboveFold} slotId="aboveFold" />
      )}
      {shouldShowSidebar ? (
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-8 min-w-0 space-y-6">
            <slot />
            {showSideDock && <MobileBottomActionDock client:load />}
          </div>
          <aside class="lg:col-span-4 min-w-0 mt-8 lg:mt-0 lg:sticky lg:top-24">
            <Sidebar />
          </aside>
        </div>
      ) : (
        <>
          <slot />
          {showSideDock && <MobileBottomActionDock client:load />}
        </>
      )}
    </main>

    <!-- Footer Ad Slot -->
    {siteConfig?.adSlots?.footer?.enabled && (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <AdSlot slotConfig={siteConfig.adSlots.footer} slotId="footer" />
      </div>
    )}

    <!-- Footer -->
    <footer class="no-print bg-charcoal-brown text-stone-ivory border-t-8 border-maroon-deep py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          
          <!-- Branding Column -->
          <div class="md:col-span-2">
            <div class="font-serif-display text-xl text-marigold uppercase tracking-wider mb-3 font-bold" role="heading" aria-level={3}>
              {siteConfig?.footer?.brandingTitle || "Ram Hanuman Chalisa"}
            </div>
            <p class="text-sm text-stone-ivory/80 max-w-sm leading-relaxed">
              {siteConfig?.footer?.brandingDesc || "A digital sanctum created to offer devotees a pure, immersive, and educational space to read, hear, and digest the glorious verses composed by Goswami Tulsidas."}
            </p>
            <div class="mt-4 flex items-center gap-4">
              <!-- Official Verified Social Links -->
              <a
                href="https://www.instagram.com/ramhanumanchalisadotcom/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs text-stone-ivory/80 hover:text-marigold transition-colors"
                aria-label="Follow Ram Hanuman Chalisa on Instagram"
              >
                <span>📷</span>
                <span>Instagram</span>
              </a>
              {/* TODO: Add official Facebook profile URL once created */}
              {/* TODO: Add official Twitter/X profile URL once created */}
              {/* TODO: Add official YouTube channel URL once created */}
            </div>
            <p class="mt-4 text-xs text-brass-gold">
              © {currentYear} {siteConfig?.footer?.copyrightText || "RamHanumanChalisa.com. All Rights Reserved."}
            </p>
          </div>

          <!-- Quick Links Column -->
          <div>
            <div class="font-serif-display text-sm uppercase tracking-widest text-marigold mb-4 font-bold" role="heading" aria-level={3}>
              Pillars
            </div>
            <ul class="space-y-2 text-sm text-stone-ivory/80">
              {(siteConfig?.footer?.quickLinks || []).map((link) => (
                <li><a href={link.href} class="hover:text-marigold transition-colors">{link.label}</a></li>
              ))}
            </ul>
          </div>

          <!-- Supporting Texts & Admin -->
          <div>
            <div class="font-serif-display text-base font-bold text-marigold mb-4 tracking-normal" role="heading" aria-level={3}>
              Devotional Texts
            </div>
            <ul class="space-y-2 text-sm text-stone-ivory/80">
              {(siteConfig?.footer?.devotionalLinks || []).map((link) => (
                <li><a href={link.href} class="hover:text-marigold transition-colors">{link.label}</a></li>
              ))}
            </ul>
          </div>

        </div>

        <hr class="my-8 border-stone-ivory/20" />

        <!-- Compliance & Footer Links -->
        <div class="flex flex-wrap justify-between items-center gap-4 text-xs text-stone-ivory/60">
          <div class="flex flex-wrap gap-4">
            {(siteConfig?.footer?.complianceLinks || []).map((link) => (
              <a href={link.href} class="hover:text-marigold">{link.label}</a>
            ))}
          </div>
          <p class="max-w-md text-right text-xs">
            {siteConfig?.footer?.disclaimerText || "Disclaimer: The materials provided are for devotional, cultural, and educational purposes."}
          </p>
        </div>

      </div>
    </footer>

    <!-- Sticky Bottom Nav (Mobile Shortcuts) -->
    <nav class="no-print md:hidden fixed bottom-0 left-0 right-0 bg-maroon-deep border-t-2 border-brass-gold text-stone-ivory z-40 flex justify-around items-center h-16 shadow-2xl">
      <a href="/" class="flex flex-col items-center justify-center w-full h-full hover:text-marigold transition-colors text-xs gap-0.5">
        <span class="text-lg">🕉️</span>
        <span>Chalisa</span>
      </a>
      <a href="/ram-chalisa" class="flex flex-col items-center justify-center w-full h-full hover:text-marigold transition-colors text-xs gap-0.5">
        <span class="text-lg">🏹</span>
        <span>Ram Chalisa</span>
      </a>
      <a href="/hanuman-chalisa-meaning" class="flex flex-col items-center justify-center w-full h-full hover:text-marigold transition-colors text-xs gap-0.5">
        <span class="text-lg">📖</span>
        <span>Meaning</span>
      </a>
      <a href="/hanuman-chalisa-audio-mp3" class="flex flex-col items-center justify-center w-full h-full hover:text-marigold transition-colors text-xs gap-0.5">
        <span class="text-lg">🎵</span>
        <span>Audio</span>
      </a>
      <a href="/hanuman-chalisa-pdf" class="flex flex-col items-center justify-center w-full h-full hover:text-marigold transition-colors text-xs gap-0.5">
        <span class="text-lg">📥</span>
        <span>Save / PDF</span>
      </a>
    </nav>

    <!-- Global Scroll To Top Button -->
    <ScrollToTop />

    <!-- Global Floating Pill Search Button & Modal -->
    <SearchModal client:idle />

    <!-- Desktop Left Margin Quick Actions Dock -->
    {showSideDock && <DesktopSideDock client:load />}

    <!-- Lazy Google AdSense (Loaded after first user interaction or window idle) -->
    <script is:inline>
      (function() {
        var loaded = false;
        function loadAdSense() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2458897753508445';
          s.async = true;
          s.crossOrigin = 'anonymous';
          document.head.appendChild(s);
        }
        ['pointerdown', 'touchstart', 'scroll', 'keydown'].forEach(function(evt) {
          window.addEventListener(evt, loadAdSense, { once: true, passive: true });
        });
        window.addEventListener('load', function() {
          setTimeout(loadAdSense, 3500);
        }, { once: true });
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --font-marcellus: 'Marcellus', serif;
    --font-tiro-devanagari: 'Tiro Devanagari Hindi', serif;
    --font-mukta: 'Mukta', sans-serif;
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-marquee {
      animation: none !important;
    }
  }
</style>

    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MJKL5P3X"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    
    <!-- Top Header / Mandir Entrance -->
    <header class="no-print w-full bg-maroon-deep border-b-4 border-brass-gold text-stone-ivory sticky top-0 z-50 shadow-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          
          <!-- Logo / Title -->
          <a href="/" class="flex items-center gap-2 group">

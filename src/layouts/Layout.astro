---
import LanguageSwitcher from "../components/LanguageSwitcher";
import ScrollToTop from "../components/ScrollToTop.astro";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  showHreflangs?: boolean;
  ogImage?: string;
}

const { 
  title = "Shree Hanuman Chalisa — Audio, Meaning, PDF & Recitation Guide", 
  description = "Step into our digital mandir. Read the authentic Hanuman Chalisa in Devanagari, English, and Gujarati, with line-by-line Hindi/English meanings, synced audio, PDF, and path vidhi.",
  canonicalUrl: propCanonicalUrl,
  showHreflangs = false,
  ogImage = "https://ramhanumanchalisa.com/og-image.jpg"
} = Astro.props;

// Determine canonical URL: prefer explicitly passed prop, otherwise derive dynamically from current route
const siteBaseUrl = "https://ramhanumanchalisa.com";
const cleanPath = Astro.url.pathname.replace(/\/+$/, "");
const canonicalUrl = propCanonicalUrl || (cleanPath ? `${siteBaseUrl}${cleanPath}` : siteBaseUrl);

const currentYear = new Date().getFullYear();
const gaId = import.meta.env.PUBLIC_GA_ID || Astro.locals.runtime?.env?.PUBLIC_GA_ID || "G-VBBLMPSKY2";

// Compute BreadcrumbList Schema dynamically
const urlObj = new URL(canonicalUrl);
const pathName = urlObj.pathname;
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://ramhanumanchalisa.com"
  }
];

if (pathName && pathName !== "/") {
  const parts = pathName.split("/").filter(Boolean);
  let accumulatedPath = "";
  parts.forEach((part, index) => {
    accumulatedPath += `/${part}`;
    let name = part
      .replace(/-/g, " ")
      .replace(/\b\w/g, (char) => char.toUpperCase());
    
    if (part === "faq") name = "FAQ";
    else if (part === "hanuman-chalisa-meaning") name = "Meaning";
    else if (part === "hanuman-chalisa-audio-mp3") name = "Synced Audio";
    else if (part === "hanuman-chalisa-pdf") name = "PDF Print";
    else if (part === "sankat-mochan-hanumanashtak") name = "Hanuman Ashtak";
    else if (part === "hanuman-aarti") name = "Hanuman Aarti";
    else if (part === "shri-hanuman-chalisa-path-vidhi") name = "Path Vidhi";
    else if (part === "hanuman-chalisa-benefits") name = "Benefits";
    else if (part === "ram-hanuman-chalisa") name = "Ram Hanuman Connection";
    else if (part === "ram-chalisa") name = "Shri Ram Chalisa";
    else if (part === "hanuman-stuti") name = "Hanuman Stuti";
    else if (part === "blog") name = "Blog";
    else if (part === "en") name = "English";
    else if (part === "te") name = "Telugu";
    else if (part === "bn") name = "Bengali";
    else if (part === "kn") name = "Kannada";
    else if (part === "gu") name = "Gujarati";
    else if (part === "mr") name = "Marathi";
    else if (part === "hi") name = "Hindi";
    
    breadcrumbItems.push({
      "@type": "ListItem",
      "position": index + 2,
      "name": name,
      "item": `https://ramhanumanchalisa.com${accumulatedPath}`
    });
  });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MJKL5P3X');</script>
    <!-- End Google Tag Manager -->

    {gaId && (
      <>
        <!-- Google Analytics -->
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){window.dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title === "Shree Hanuman Chalisa — Audio, Meaning, PDF & Recitation Guide" ? title : `${title} | Ram Hanuman Chalisa`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {showHreflangs && (
      <>
        <!-- Hreflang Alternate Translation Tags -->
        <link rel="alternate" hreflang="x-default" href="https://ramhanumanchalisa.com/" />
        <link rel="alternate" hreflang="hi" href="https://ramhanumanchalisa.com/" />
        <link rel="alternate" hreflang="en" href="https://ramhanumanchalisa.com/hanuman-chalisa/en" />
        <link rel="alternate" hreflang="te" href="https://ramhanumanchalisa.com/hanuman-chalisa/te" />
        <link rel="alternate" hreflang="bn" href="https://ramhanumanchalisa.com/hanuman-chalisa/bn" />
        <link rel="alternate" hreflang="kn" href="https://ramhanumanchalisa.com/hanuman-chalisa/kn" />
        <link rel="alternate" hreflang="gu" href="https://ramhanumanchalisa.com/hanuman-chalisa/gu" />
        <link rel="alternate" hreflang="mr" href="https://ramhanumanchalisa.com/hanuman-chalisa/mr" />
      </>
    )}
    
    <!-- Google Fonts Preconnect and Link -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Marcellus&family=Mukta:wght@200;300;400;500;600;700;800&family=Tiro+Devanagari+Hindi&display=swap" rel="stylesheet" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content="Shree Ram and Hanuman Devotional Banner - RamHanumanChalisa.com" />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />
    <meta property="twitter:image:alt" content="Shree Ram and Hanuman Devotional Banner - RamHanumanChalisa.com" />

    <!-- Breadcrumb Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>
  <body class="min-h-full flex flex-col font-body bg-stone-ivory text-charcoal-brown selection:bg-marigold selection:text-maroon-deep">
